---
import '../styles/global.css';
import '../styles/animations.css';
import vanndikLogo from '../../logo-512.png';

const { title, description, active = '' } = Astro.props;
const navItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Tentang', href: '/tentang/' },
  { label: 'Berita', href: '/berita/' },
  { label: 'Artikel', href: '/artikel/' },
  { label: 'Produk', href: '/produk/' },
  { label: 'Aplikasi', href: '/aplikasi/' },
  { label: 'Game', href: '/game/' },
];
const languages = [
  ['id', '🇮🇩', 'Bahasa Indonesia'], ['en', '🇬🇧', 'English'],
  ['jv', '🇮🇩', 'Basa Jawa'], ['su', '🇮🇩', 'Basa Sunda'],
  ['ms', '🇲🇾', 'Bahasa Melayu'], ['ja', '🇯🇵', '日本語'],
  ['ko', '🇰🇷', '한국어'], ['zh', '🇨🇳', '简体中文'], ['ar', '🇸🇦', 'العربية'],
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b12" />
    <meta name="description" content={description} />
    <title>{title} — VANNDIK</title>
    <link rel="icon" type="image/png" href={vanndikLogo.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body data-cms-page={active.replaceAll("/", "") || "home"}>
    <div class="site-shell">
      <header class="site-header inner-header">
        <a class="wordmark" href="/" aria-label="VANNDIK home"><img class="brand-logo" src={vanndikLogo.src} alt="VANNDIK" /></a>
        <nav class="desktop-nav" id="mainNavigation" aria-label="Navigasi utama">
          {navItems.map((item) => <a href={item.href} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <div class="language-picker">
            <button class="language-trigger" id="languageTrigger" type="button" aria-expanded="false" aria-label="Pilih bahasa">
              <span class="globe-icon">◎</span><span id="currentLanguage">ID</span><span class="chevron">⌄</span>
            </button>
            <div class="language-menu" id="languageMenu" hidden>
              {languages.map(([code, flag, label]) => <button class="language-option" type="button" data-lang={code}><span class="language-flag">{flag}</span><span>{label}</span><span class="language-code">{code.toUpperCase()}</span></button>)}
            </div>
          </div>
          <a class="header-cta" href="/aplikasi/">Aplikasi <span>↗</span></a>
          <button class="mobile-menu-toggle" id="mobileMenuToggle" type="button" aria-label="Buka menu" aria-expanded="false"><span></span><span></span></button>
        </div>
      </header>
      <main class="inner-main">
        <slot />
      </main>
      <footer class="site-footer inner-footer">
        <a class="wordmark footer-wordmark" href="/" aria-label="VANNDIK home"><img class="brand-logo footer-brand-logo" src={vanndikLogo.src} alt="VANNDIK" /></a>
        <p>Ruang digital untuk ide, karya, teknologi, dan kemungkinan baru.</p>
        <div class="footer-meta"><span>© {new Date().getFullYear()} VANNDIK</span><a href="#top">KEMBALI KE ATAS ↑</a></div>
      </footer>
    </div>
    <script is:inline>
      const trigger = document.getElementById('languageTrigger');
      const menu = document.getElementById('languageMenu');
      const current = document.getElementById('currentLanguage');
      const options = document.querySelectorAll('[data-lang]');
      const mobileToggle = document.getElementById('mobileMenuToggle');
      const nav = document.getElementById('mainNavigation');
      const savedLanguage = localStorage.getItem('vanndik-language') || 'id';
      current.textContent = savedLanguage.toUpperCase();
      options.forEach((option) => option.classList.toggle('is-selected', option.dataset.lang === savedLanguage));
      trigger.addEventListener('click', () => {
        menu.hidden = !menu.hidden;
        trigger.setAttribute('aria-expanded', String(!menu.hidden));
      });
      options.forEach((option) => option.addEventListener('click', () => {
        const code = option.dataset.lang;
        localStorage.setItem('vanndik-language', code);
        current.textContent = code.toUpperCase();
        document.documentElement.lang = code;
        document.documentElement.dir = code === 'ar' ? 'rtl' : 'ltr';
        options.forEach((item) => item.classList.toggle('is-selected', item.dataset.lang === code));
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      }));
      document.addEventListener('click', (event) => {
        if (!event.target.closest('.language-picker')) {
          menu.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
        }
      });
      mobileToggle.addEventListener('click', () => {
        const open = nav.classList.toggle('is-open');
        mobileToggle.setAttribute('aria-expanded', String(open));
      });
      nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        mobileToggle.setAttribute('aria-expanded', 'false');
      }));
    </script>
    <script is:inline>
      // Reveal cards as they enter the viewport; respect reduced-motion preferences.
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));
      }
    </script>
    <script is:inline src="/site-cms.js"></script>
    <style>
      .inner-header{position:sticky;background:rgba(8,11,18,.88)}
      .inner-main{min-height:calc(100vh - 150px);padding:0 0 70px}
      .inner-footer{position:relative}
      .desktop-nav a[aria-current="page"]{color:#fff}
      .desktop-nav a[aria-current="page"]::after{content:'';display:block;height:2px;background:#2878ff;margin-top:7px;border-radius:2px}
      .page-hero{position:relative;overflow:hidden;padding:105px max(24px,calc((100% - 1120px)/2)) 75px;background:radial-gradient(ellipse at 82% 30%,#174b9233,transparent 42%),linear-gradient(135deg,#0b111d,#080b12)}
      .page-hero::before{content:'';position:absolute;inset:0;background-image:linear-gradient(#7b9dc70a 1px,transparent 1px),linear-gradient(90deg,#7b9dc70a 1px,transparent 1px);background-size:58px 58px;mask-image:linear-gradient(to bottom,black,transparent)}
      .page-hero>*{position:relative}
      .page-eyebrow{color:#78aaff;font-size:10px;font-weight:700;letter-spacing:2px;margin-bottom:20px}
      .page-hero h1{font-size:clamp(42px,6vw,68px);letter-spacing:-3px;line-height:1.1;max-width:820px;margin:0 0 20px}
      .page-hero p{color:#a0adbf;font-size:15px;line-height:1.9;max-width:680px;margin:0}
      .page-content{width:min(1120px,calc(100% - 48px));margin:0 auto;padding-top:55px}
      .page-section-title{font:700 24px Manrope,sans-serif;letter-spacing:-.8px;margin:0 0 12px}
      .page-muted{color:#98a5b8;line-height:1.9;font-size:14px}
      .content-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:26px}
      .content-card{min-height:205px;padding:25px;border:1px solid var(--line);border-radius:8px;background:linear-gradient(145deg,#111927,#0b111b)}
      .content-card .card-index{color:#73a8ff;font-size:10px;letter-spacing:1.5px}
      .content-card h2,.content-card h3{font-size:19px;margin:28px 0 9px;letter-spacing:-.5px}
      .content-card p{font-size:12px;line-height:1.8;color:#91a0b4;margin:0}
      .empty-state{padding:42px 28px;border:1px dashed rgba(117,157,216,.3);border-radius:8px;background:#0c1420;text-align:center}
      .empty-state-icon{font-size:27px;color:#73a8ff;margin-bottom:14px}
      .empty-state h2{font:700 22px Manrope,sans-serif;margin:0 0 10px}
      .empty-state p{color:#91a0b4;font-size:13px;line-height:1.8;max-width:540px;margin:0 auto}
      .notice-line{border-left:2px solid #2878ff;padding:12px 16px;background:#101a2a;color:#a9b8cd;font-size:12px;line-height:1.8;margin-top:22px}
      .app-card{display:flex;flex-direction:column;gap:12px;min-height:230px}
      .app-icon{width:42px;height:42px;display:grid;place-items:center;border:1px solid #315b91;border-radius:10px;background:#142846;color:#8dbaff;font-size:19px}
      .status-soon{align-self:flex-start;border:1px solid #315b91;border-radius:30px;padding:5px 9px;color:#8dbaff;font-size:9px;letter-spacing:1px}
      .app-card h3{margin:3px 0 0}
      @media(max-width:900px){.desktop-nav{gap:15px;margin-left:0}.desktop-nav a{font-size:11px}.header-actions{gap:13px}}
      @media(max-width:680px){.inner-header{height:70px}.inner-header .desktop-nav{display:none;position:absolute;top:69px;left:0;right:0;padding:18px 24px 22px;background:#0c1320;border-bottom:1px solid var(--line);flex-direction:column;align-items:flex-start;gap:19px}.inner-header .desktop-nav.is-open{display:flex}.inner-header .header-cta{display:none}.inner-header .mobile-menu-toggle{display:block}.page-hero{padding:78px 24px 55px}.page-hero h1{font-size:43px;letter-spacing:-2px}.page-hero p{font-size:13px}.page-content{width:calc(100% - 44px);padding-top:38px}.content-grid{grid-template-columns:1fr;gap:11px}.content-card{min-height:175px}.inner-footer{grid-template-columns:1fr auto}}
    
      /* Neon accents across all secondary pages */
      :root{color-scheme:dark}
      .site-header{border-color:rgba(143,160,196,.18);background:rgba(5,6,10,.9)}
      .language-trigger{background:#0d111b}
      .language-menu{background:#0b0e17}
      .language-option:hover,.language-option.is-selected{background:#151d30}
      .desktop-nav a[aria-current="page"]{color:#42d9ff}
      .desktop-nav a[aria-current="page"]::after{background:linear-gradient(90deg,#1769ff,#a855f7)}
      .page-hero{background:radial-gradient(ellipse at 82% 30%,#1769ff30,transparent 42%),radial-gradient(ellipse at 12% 80%,#a855f71b,transparent 35%),#070910}
      .page-hero::before{background-image:linear-gradient(#8299c20b 1px,transparent 1px),linear-gradient(90deg,#8299c20b 1px,transparent 1px)}
      .page-eyebrow{color:#42d9ff}
      .content-card{background:radial-gradient(ellipse at 90% 0%,#a855f711,transparent 45%),linear-gradient(145deg,#111522,#090b12)}
      .content-card:hover{border-color:#42d9ff66;box-shadow:0 0 24px #1769ff18}
      .content-card .card-index{color:#42d9ff}
      .empty-state{background:#0b0e16;border-color:#39ff8855}
      .empty-state-icon{color:#a855f7;text-shadow:0 0 20px #a855f766}
      .notice-line{border-color:#39ff88;background:#39ff880d}
      .app-icon{border-color:#a855f766;background:#a855f71a;color:#c99aff;box-shadow:0 0 18px #a855f71a}
      .status-soon{border-color:#39ff8855;color:#39ff88;background:#39ff8810}
      .inner-footer{border-color:rgba(143,160,196,.18)}
      @media(max-width:680px){.inner-header .desktop-nav.is-open{background:#080b12}}
\n    </style>
  </body>
</html>
