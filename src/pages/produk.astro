---
import SecondaryLayout from '../layouts/SecondaryLayout.astro';
const categories = ['Semua produk','Elektronik','Komputer & Aksesori','Rumah & Gaya Hidup','Fashion','Kecantikan'];
const filters = ['Rekomendasi','Terbaru','Harga terendah','Harga tertinggi'];
---
<SecondaryLayout title="Produk Pilihan" description="Temukan dan bandingkan produk pilihan dari berbagai kategori dan marketplace." active="/produk/">
<section class="shop-head" id="top"><div class="shop-width"><div class="brandline"><b class="brand-icon">V.</b> VANNDIK <strong>SHOPPING</strong><i></i><small>PILIHAN PRODUK</small></div><div class="shop-intro"><div><span class="eyebrow">DISCOVER • COMPARE • CHOOSE</span><h1>Temukan produk<br/><span class="text-gradient">yang tepat untukmu.</span></h1><p>Jelajahi pilihan produk dari berbagai kategori dan marketplace. Bandingkan informasi penting sebelum menentukan pilihan.</p></div><aside><small>VANNDIK PICKS</small><b>Pilihan cerdas,<br/>belanja lebih yakin.</b><span>Kurasi produk lintas kategori</span></aside></div><div class="shop-search"><span>⌕</span><input id="productSearch" type="search" placeholder="Cari produk, merek, atau kategori..." aria-label="Cari produk"/><button id="productSearchButton" type="button">Cari</button></div><nav class="shop-categories">{categories.map((c,i)=><button type="button" class:list={['shop-category',{active:i===0}]} data-category-filter={c}>{c}</button>)}</nav></div></section>
<section class="shop-main shop-width"><div class="section-head"><div><small>JELAJAHI KATALOG</small><h2>Produk untuk berbagai kebutuhan</h2><p>Inspirasi kategori dan ruang untuk rekomendasi produk pilihan.</p></div><span>KATALOG VANNDIK</span></div><div class="shop-tiles"><a href="#products"><small>01 / GADGET</small><b>Elektronik</b><span>Perangkat untuk aktivitas harian</span><i>↗</i></a><a href="#products"><small>02 / WORKSPACE</small><b>Komputer & Aksesori</b><span>Teman produktivitas dan kerja</span><i>↗</i></a><a href="#products"><small>03 / LIFESTYLE</small><b>Rumah & Gaya Hidup</b><span>Temukan inspirasi keseharian</span><i>↗</i></a><a href="#products"><small>04 / STYLE</small><b>Fashion & Kecantikan</b><span>Lengkapi gaya personalmu</span><i>↗</i></a></div>
<div class="products-toolbar" id="products"><div><small>PILIHAN VANNDIK</small><h2>Rekomendasi produk</h2></div><nav>{filters.map((f,i)=><button type="button" class:active={i===0} data-sort={f}>{f}</button>)}</nav></div><div class="product-grid">{Array.from({length:4},(_,i)=><article class="product-card"><div class:list={['product-image','product-image-'+(i+1)]}><span>PRODUCT PREVIEW</span><b>0{i+1}</b><div class="product-object"><i></i><em></em></div></div><div class="product-copy"><small>KATEGORI PRODUK</small><h3>Ruang untuk produk pilihan</h3><p>Foto, nama, harga, dan informasi toko akan ditampilkan setelah data produk tersedia.</p><footer><span>Harga mengikuti marketplace</span><span>Detail ↗</span></footer></div></article>)}</div><div class="note"><b>ⓘ</b><p>Ini adalah pratinjau desain katalog. Belum ada produk, harga, rating, atau tautan toko yang ditayangkan. Informasi produk akan ditampilkan berdasarkan data dan sumber yang dapat diverifikasi.</p></div><div class="affiliate-note"><b>◇</b><div><strong>Belanja dengan informasi yang transparan</strong><p>Beberapa tautan produk nantinya dapat berupa tautan affiliate. VANNDIK dapat menerima komisi apabila pembelian dilakukan melalui tautan tersebut, tanpa biaya tambahan bagi pembeli.</p></div></div></section>
<script is:inline>
const categoryButtons=document.querySelectorAll('[data-category-filter]');categoryButtons.forEach(button=>button.addEventListener('click',()=>categoryButtons.forEach(item=>item.classList.toggle('active',item===button))));
const search=document.getElementById('productSearch');document.getElementById('productSearchButton').addEventListener('click',()=>search.focus());search.addEventListener('keydown',e=>{if(e.key==='Enter')search.blur()});
const sortButtons=document.querySelectorAll('[data-sort]');sortButtons.forEach(button=>button.addEventListener('click',()=>sortButtons.forEach(item=>item.classList.toggle('active',item===button))));
</script>
<style>
.shop-width{width:min(1160px,calc(100% - 48px));margin:0 auto}.shop-head{background:radial-gradient(ellipse at 82% 28%,#174b9230,transparent 37%),linear-gradient(130deg,#0b111d,#080b12 80%);border-bottom:1px solid var(--line);padding:42px 0 25px}.brandline{display:flex;align-items:center;gap:9px;font:800 12px Manrope,sans-serif;letter-spacing:1.4px}.brandline strong{color:#83b1ff}.brandline i{height:17px;width:1px;background:#34435b;margin:0 5px}.brandline small{font:600 8px 'DM Sans',sans-serif;letter-spacing:1.7px;color:#7889a3}.brand-icon{display:grid;place-items:center;width:28px;height:28px;border-radius:7px;background:#1769ff;color:white;font-size:15px}.shop-intro{display:flex;align-items:center;justify-content:space-between;gap:30px;padding:48px 0 34px}.eyebrow,.section-head small,.products-toolbar small{font-size:9px;letter-spacing:2px;font-weight:700;color:#82adf3}.shop-intro h1{font:750 clamp(38px,5vw,61px)/1.12 Manrope,sans-serif;letter-spacing:-3px;margin:15px 0}.shop-intro p{max-width:570px;color:#9aa8bc;font-size:12px;line-height:1.9;margin:0}.shop-intro aside{min-width:235px;padding:22px 24px;border:1px solid #2c4c76;border-radius:8px;background:linear-gradient(145deg,#142743,#0e1726);display:flex;flex-direction:column;gap:10px}.shop-intro aside small{font-size:8px;letter-spacing:2px;color:#83b1ff}.shop-intro aside b{font:700 19px/1.35 Manrope}.shop-intro aside span{font-size:9px;color:#8b9cb3}.shop-search{display:flex;align-items:center;gap:12px;height:49px;max-width:760px;padding:0 7px 0 16px;border:1px solid #2b3d57;border-radius:6px;background:#111b2a}.shop-search>span{font-size:23px;color:#83a9e4}.shop-search input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#eaf1fc;font:12px 'DM Sans',sans-serif}.shop-search input::placeholder{color:#77869c}.shop-search button{height:35px;padding:0 18px;border:0;border-radius:4px;background:#1769ff;color:white;font-size:10px;font-weight:700;cursor:pointer}.shop-categories{display:flex;gap:9px;overflow:auto;padding:22px 0 0;scrollbar-width:none}.shop-category{white-space:nowrap;border:1px solid #29374d;background:#111a28;color:#9ba9bd;border-radius:30px;padding:9px 14px;font-size:10px;cursor:pointer}.shop-category.active,.shop-category:hover{background:#17335c;border-color:#326ab1;color:#fff}.shop-main{padding:50px 0 80px}.section-head,.products-toolbar{display:flex;align-items:flex-end;justify-content:space-between;gap:20px}.section-head h2,.products-toolbar h2{font:700 25px Manrope,sans-serif;letter-spacing:-1px;margin:8px 0}.section-head p{font-size:11px;color:#8e9db2;margin:0}.section-head>span{font-size:8px;letter-spacing:1.5px;color:#7386a1}.shop-tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:23px}.shop-tiles a{position:relative;overflow:hidden;min-height:155px;display:flex;flex-direction:column;justify-content:flex-end;gap:7px;padding:18px;border:1px solid #ffffff12;border-radius:7px;background:linear-gradient(145deg,#1c3859,#101c2c)}.shop-tiles a:before{content:'';position:absolute;width:130px;height:130px;border:1px solid #9fc6ff26;border-radius:50%;right:-35px;top:-45px;box-shadow:0 0 0 18px #9fc6ff08,0 0 0 38px #9fc6ff06}.shop-tiles small,.shop-tiles b,.shop-tiles span,.shop-tiles i{position:relative}.shop-tiles small{font-size:7px;letter-spacing:1.7px;color:#9ebde5}.shop-tiles b{font:650 15px Manrope}.shop-tiles span{font-size:9px;color:#9aaac0}.shop-tiles i{position:absolute;right:16px;bottom:17px;color:#9bc2fa;font-style:normal}.shop-tiles a:nth-child(2){background:linear-gradient(145deg,#283456,#111a2b)}.shop-tiles a:nth-child(3){background:linear-gradient(145deg,#26404b,#111c27)}.shop-tiles a:nth-child(4){background:linear-gradient(145deg,#3a304c,#171b2b)}.products-toolbar{margin:55px 0 20px}.products-toolbar h2{margin-bottom:0}.products-toolbar nav{display:flex;gap:7px;flex-wrap:wrap}.products-toolbar button{border:1px solid #2a3b54;border-radius:4px;background:#101722;color:#8999b0;padding:8px 10px;font-size:9px;cursor:pointer}.products-toolbar button.active,.products-toolbar button:hover{color:#fff;border-color:#3d70b2;background:#142747}.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.product-card{overflow:hidden;border:1px solid var(--line);border-radius:7px;background:#0e1725;transition:transform .2s,border-color .2s}.product-card:hover{transform:translateY(-3px);border-color:#365b8b}.product-image{height:190px;position:relative;display:grid;place-items:center;overflow:hidden;background:radial-gradient(circle at 50% 48%,#304c70,#17283e 55%,#101a29)}.product-image:after{content:'';position:absolute;inset:0;background:linear-gradient(120deg,transparent 35%,#ffffff0a 50%,transparent 65%)}.product-image>span{position:absolute;left:13px;top:13px;color:#a9c5e9;font-size:7px;letter-spacing:1.5px}.product-image>b{position:absolute;right:13px;bottom:11px;color:#ffffff66;font:700 17px Manrope}.product-object{position:relative;width:95px;height:110px;display:grid;place-items:center;filter:drop-shadow(0 15px 15px #0008)}.product-object:before{content:'';width:66px;height:83px;border-radius:12px 12px 17px 17px;background:linear-gradient(110deg,#8ea6c0,#344f70 48%,#172c45);border:1px solid #c0d4ed55;transform:rotate(-8deg)}.product-object:after{content:'';position:absolute;top:7px;width:25px;height:5px;border-radius:4px;background:#b8cce4;opacity:.65}.product-object i{position:absolute;z-index:1;width:13px;height:13px;border:2px solid #c3d7ef;border-radius:50%;top:27px;left:38px}.product-object em{position:absolute;z-index:1;width:33px;height:3px;background:#c3d7ef88;top:55px;left:31px}.product-image-2{background:radial-gradient(circle at 50% 48%,#3c426c,#20243d 55%,#111727)}.product-image-2 .product-object:before{width:112px;height:58px;border-radius:9px;background:linear-gradient(145deg,#a9b5c7,#394b68);transform:rotate(-7deg)}.product-image-2 .product-object:after{top:23px;width:38px;height:4px}.product-image-2 .product-object i{top:42px;left:44px;width:7px;height:7px}.product-image-2 .product-object em{top:75px;left:33px;width:50px}.product-image-3{background:radial-gradient(circle at 50% 48%,#34545b,#172c34 55%,#101b22)}.product-image-3 .product-object:before{width:82px;height:82px;border-radius:50%;background:linear-gradient(145deg,#b6c4c0,#3d5c5a);transform:none}.product-image-3 .product-object:after{top:17px;width:31px;height:6px}.product-image-4{background:radial-gradient(circle at 50% 48%,#554269,#2c233d 55%,#171625)}.product-image-4 .product-object:before{width:75px;height:98px;border-radius:32px 32px 10px 10px;background:linear-gradient(145deg,#c3a6b8,#654b70);transform:rotate(5deg)}.product-copy{padding:15px}.product-copy>small{font-size:7px;letter-spacing:1.5px;color:#83adf3}.product-copy h3{font:650 14px Manrope;margin:8px 0}.product-copy p{font-size:9px;line-height:1.8;color:#8e9db2;min-height:48px;margin:0 0 13px}.product-copy footer{display:flex;justify-content:space-between;gap:8px;padding-top:11px;border-top:1px solid #ffffff0d;color:#8294ae;font-size:8px}.note{display:flex;gap:10px;margin-top:20px;padding:13px 15px;border-left:2px solid #2878ff;background:#101a2a;color:#91a4bf}.note b{color:#83adf3}.note p{font-size:10px;line-height:1.8;margin:0}.affiliate-note{display:flex;align-items:flex-start;gap:15px;margin-top:24px;padding:20px;border:1px solid #263d5b;border-radius:7px;background:linear-gradient(110deg,#111e30,#0c1420)}.affiliate-note>b{display:grid;place-items:center;flex:0 0 36px;height:36px;border-radius:8px;background:#17345a;color:#9cc3ff;font-size:19px}.affiliate-note strong{font:650 13px Manrope}.affiliate-note p{font-size:10px;line-height:1.8;color:#94a4ba;margin:7px 0 0}
@media(max-width:900px){.shop-tiles{grid-template-columns:repeat(2,1fr)}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.shop-intro h1{font-size:48px}}
@media(max-width:620px){.shop-width{width:calc(100% - 40px)}.shop-head{padding:30px 0 23px}.shop-intro{padding:37px 0 24px;display:block}.shop-intro h1{font-size:39px;letter-spacing:-2px}.shop-intro p{font-size:11px}.shop-intro aside{margin-top:20px;padding:17px}.shop-intro aside b{font-size:16px}.shop-search{height:45px}.shop-search button{padding:0 12px}.shop-main{padding:38px 0 60px}.section-head h2,.products-toolbar h2{font-size:21px}.section-head>span{display:none}.shop-tiles{gap:9px}.shop-tiles a{min-height:135px;padding:13px}.shop-tiles b{font-size:12px}.products-toolbar{display:block;margin-top:43px}.products-toolbar nav{margin-top:14px}.products-toolbar button{font-size:8px;padding:8px}.product-grid{gap:9px}.product-image{height:145px}.product-copy{padding:12px}.product-copy h3{font-size:12px}.product-copy p{font-size:8px;min-height:60px}.product-copy footer{font-size:7px}.affiliate-note{padding:15px}}
</style>
</SecondaryLayout>