<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#080c14"><title>Monetization Center — VANNDIK</title><style>
:root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,sans-serif;background:#070b14;color:#edf5ff}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 15% 0%,#087da51c,transparent 35%),radial-gradient(ellipse at 90% 10%,#6652a31c,transparent 30%),#070b14}.wrap{max-width:1320px;margin:auto;padding:26px clamp(16px,3vw,40px) 70px}.top{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px 18px;border:1px solid #263c55;border-radius:13px;background:#0b1524;margin-bottom:35px}.brand{font-size:12px;font-weight:900;letter-spacing:2px}.brand span{color:#36d9f5}a{color:#91dfff;text-decoration:none;font-size:11px}.eyebrow{font-size:10px;letter-spacing:2.5px;color:#36d9f5;font-weight:800}.heading{font-size:clamp(32px,4vw,48px);margin:12px 0 8px;letter-spacing:-1.5px}.sub{max-width:750px;color:#91a6c2;font-size:13px;line-height:1.8}.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:24px 0}.toolbar select,.btn{padding:11px 14px;border-radius:9px;border:1px solid #29445f;background:#101e30;color:#eaf5ff;font-size:11px}.btn{background:linear-gradient(110deg,#08799a,#2456bd);font-weight:750;cursor:pointer}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.card,.panel{background:linear-gradient(145deg,#101e30,#0a1422);border:1px solid #243b55;border-radius:14px;padding:18px;min-width:0}.label{font-size:9px;color:#8ca8c5;letter-spacing:1px;text-transform:uppercase}.value{font-size:clamp(20px,2.3vw,30px);font-weight:850;margin-top:12px;overflow-wrap:anywhere}.hint{font-size:10px;color:#718ca8;margin-top:7px}.panel{margin-top:14px}.panel h2{font-size:14px;margin:0 0 12px}.status{padding:13px;border:1px solid #31496a;border-radius:9px;color:#a9c0dc;font-size:11px;line-height:1.8}.status.ok{border-color:#286b58;color:#9ae5c8}.status.bad{border-color:#74434a;color:#ffb3b3}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;font-size:11px;min-width:620px}.table th,.table td{text-align:left;padding:11px;border-bottom:1px solid #20364e;white-space:nowrap}.table th{color:#82a5c6}.muted{font-size:11px;color:#829bb6;line-height:1.8}.note{margin-top:15px;color:#829bb6;font-size:10px;line-height:1.8}@media(max-width:850px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.grid{grid-template-columns:1fr 1fr}.card{padding:13px}.value{font-size:20px}.top{align-items:flex-start;flex-direction:column}}
</style></head><body><main class="wrap">
<div class="top"><div class="brand">VANNDIK<span>.</span> MONETIZATION CENTER</div><div><a href="/admin/">← Kembali ke CMS</a>　<a href="/admin/growth/">Growth Intelligence ↗</a></div></div>
<div class="eyebrow">REVENUE & PARTNER PERFORMANCE</div><h1 class="heading">Monetization Center</h1><p class="sub">Pusat pemantauan pendapatan iklan dan komisi affiliate VANNDIK. Nilai hanya ditampilkan dari sumber aktual; data yang belum terhubung tidak akan diisi dengan angka simulasi.</p>
<div class="toolbar"><select id="days"><option value="7">7 hari terakhir</option><option value="30" selected>30 hari terakhir</option><option value="90">90 hari terakhir</option></select><button class="btn" id="refresh">Ambil data AdSense</button><span id="updated" class="muted">Belum mengambil laporan.</span></div>
<div class="grid">
<div class="card"><div class="label">Estimasi pendapatan AdSense</div><div class="value" id="earnings">—</div><div class="hint" id="currency">Menunggu data Google</div></div>
<div class="card"><div class="label">Klik iklan</div><div class="value" id="clicks">—</div><div class="hint">Google AdSense</div></div>
<div class="card"><div class="label">Tayangan halaman</div><div class="value" id="views">—</div><div class="hint">Page views</div></div>
<div class="card"><div class="label">Impresi iklan</div><div class="value" id="impressions">—</div><div class="hint">Ad impressions</div></div>
<div class="card"><div class="label">CTR halaman</div><div class="value" id="ctr">—</div><div class="hint">Page click-through rate</div></div>
<div class="card"><div class="label">RPM halaman</div><div class="value" id="rpm">—</div><div class="hint">Pendapatan per 1.000 page views</div></div>
<div class="card"><div class="label">Komisi affiliate</div><div class="value" id="affiliateCommission">—</div><div class="hint" id="affiliateHint">Impor laporan komisi aktual</div></div>
<div class="card"><div class="label">Total pendapatan terdata</div><div class="value" id="combinedRevenue">—</div><div class="hint" id="combinedHint">Dikelompokkan per mata uang</div></div>
</div>
<section class="panel"><h2>Koneksi Google AdSense</h2><div id="connection" class="status">Memeriksa koneksi…</div><p class="muted">Akun pemilik yang diizinkan: dickv940@gmail.com. Gunakan tombol di bawah untuk memberikan izin baca AdSense melalui Google OAuth yang sudah digunakan oleh Growth Intelligence.</p><button class="btn" id="connect">Hubungkan / perbarui izin Google</button></section>
<section class="panel"><h2>Riwayat pendapatan harian</h2><div id="table" class="muted">Belum ada laporan.</div></section>
<section class="panel"><h2>Affiliate & impor komisi aktual</h2><p class="muted">Unduh laporan komisi dari Shopee Affiliate atau platform terkait, lalu sesuaikan kolom ke format CSV VANNDIK. Data pesanan yang sama akan diperbarui, bukan digandakan.</p><p><a href="/affiliate-commission-template.csv" download>Unduh template CSV komisi ↗</a></p><div class="toolbar"><input id="commissionFile" type="file" accept=".csv,text/csv"><button class="btn" id="importCommission" type="button">Impor komisi CSV</button></div><div id="affiliateStatus" class="status">Belum ada laporan komisi yang diimpor.</div><div id="affiliateBreakdown" class="muted"></div><p class="note">Kolom CSV wajib: platform, order_id, order_date, commission, currency, status. Platform: shopee, tiktok, tokopedia, lazada, amazon, other. Status: pending, approved, paid, cancelled. Maksimal 200 baris per impor. Komisi diimpor dari laporan resmi yang kamu unduh; CMS tidak mengarang komisi atau menganggap klik sebagai pesanan.</p></section>
<p class="note">Catatan: AdSense menampilkan estimasi pendapatan yang dapat berubah setelah validasi. Data laporan API biasanya tidak mencakup informasi pembayaran final atau saldo pencairan. Waktu dan ketersediaan data mengikuti Google.</p>
</main><script>
const $=id=>document.getElementById(id),fmt=n=>new Intl.NumberFormat('id-ID',{maximumFractionDigits:2}).format(Number(n||0));
async function api(path){const r=await fetch('/api/cms/adsense/'+path,{credentials:'same-origin'});const d=await r.json().catch(()=>({}));if(r.status===401){location.href='/admin/';throw Error('Sesi admin berakhir.')}if(!r.ok)throw Error(d.error||'Permintaan gagal');return d}
function set(id,value){$(id).textContent=value??'—'}
async function loadStatus(){try{const d=await api('status');$('connection').textContent=d.connected?'Koneksi Google aktif sebagai '+d.email+' sejak '+new Date(d.connectedAt).toLocaleString('id-ID'):(d.configured?'OAuth tersedia, akun Google belum terhubung.':'Konfigurasi OAuth Cloudflare belum lengkap.');$('connection').className='status '+(d.connected?'ok':'bad');$('connect').disabled=!d.configured;$('connect').textContent=d.connected?'Hubungkan ulang / tambah izin AdSense':'Hubungkan akun Google'}catch(e){$('connection').textContent=e.message;$('connection').className='status bad'}}
function metric(total,key){return total?.[key]??null}
function parseCsv(text){const lines=text.replace(/^\\uFEFF/,'').split(/\\r?\\n/).filter(x=>x.trim());if(lines.length<2)throw Error('CSV belum berisi baris data.');const parse=line=>{const out=[];let v='',q=false;for(let i=0;i<line.length;i++){const ch=line[i];if(ch==='"'&&q&&line[i+1]==='"'){v+='"';i++}else if(ch==='"'){q=!q}else if(ch===','&&!q){out.push(v.trim());v=''}else v+=ch}out.push(v.trim());return out};const heads=parse(lines[0]).map(x=>x.toLowerCase());return lines.slice(1).map(line=>{const vals=parse(line);return Object.fromEntries(heads.map((h,i)=>[h,vals[i]??'']))})}
async function loadAffiliate(){try{const d=await api('affiliate-summary');const totals=d.totalsByCurrency||{};const parts=Object.entries(totals).filter(([,v])=>Number(v)>0).map(([cur,v])=>cur+' '+new Intl.NumberFormat('id-ID',{style:'currency',currency:cur,maximumFractionDigits:2}).format(v));set('affiliateCommission',parts.length?parts.join(' / '):'—');set('affiliateHint',(d.totalClicks||0).toLocaleString('id-ID')+' klik tercatat · '+(d.groups||[]).reduce((n,x)=>n+Number(x.orders||0),0)+' pesanan komisi');const merged={...(totals)};const adsCurrency=(($('currency').textContent||'').match(/[A-Z]{3}/)||[])[0];const adsValue=Number((window.__adsenseTotal||{}).ESTIMATED_EARNINGS);if(adsCurrency&&Number.isFinite(adsValue))merged[adsCurrency]=(merged[adsCurrency]||0)+adsValue;const sumParts=Object.entries(merged).filter(([,v])=>Number(v)>0).map(([cur,v])=>cur+' '+new Intl.NumberFormat('id-ID',{style:'currency',currency:cur,maximumFractionDigits:2}).format(v));set('combinedRevenue',sumParts.length?sumParts.join(' / '):'—');set('combinedHint','Total per mata uang; estimasi AdSense dapat berubah');$('affiliateBreakdown').innerHTML=(d.groups||[]).length?'<div class="table-wrap"><table class="table"><thead><tr><th>Platform</th><th>Status</th><th>Pesanan</th><th>Komisi</th><th>Mata uang</th></tr></thead><tbody>'+d.groups.map(x=>'<tr><td>'+x.platform+'</td><td>'+x.status+'</td><td>'+fmt(x.orders)+'</td><td>'+fmt(x.commission)+'</td><td>'+x.currency+'</td></tr>').join('')+'</tbody></table></div>':'Belum ada komisi aktual tersimpan.'}catch(e){$('affiliateStatus').textContent=e.message}}
async function importAffiliate(){const file=$('commissionFile').files[0];if(!file){$('affiliateStatus').textContent='Pilih file CSV terlebih dahulu.';return}const btn=$('importCommission');btn.disabled=true;$('affiliateStatus').textContent='Membaca dan mengimpor laporan…';try{const rows=parseCsv(await file.text());const r=await fetch('/api/cms/adsense/affiliate-import',{method:'POST',credentials:'same-origin',headers:{'content-type':'application/json'},body:JSON.stringify({rows})});const d=await r.json().catch(()=>({}));if(r.status===401){location.href='/admin/';throw Error('Sesi admin berakhir.')}if(!r.ok)throw Error(d.error||'Impor gagal');$('affiliateStatus').textContent='Impor selesai: '+d.imported+' baris diproses, '+d.rejected+' baris ditolak.';$('affiliateStatus').className='status ok';await loadAffiliate()}catch(e){$('affiliateStatus').textContent=e.message;$('affiliateStatus').className='status bad'}finally{btn.disabled=false}}

async function report(){const days=$('days').value;$('refresh').disabled=true;$('updated').textContent='Mengambil laporan dari Google…';try{const d=await api('report?days='+days);window.__adsenseTotal=d.total||{};const currency=d.currency||'Mata uang akun';const earnings=metric(d.total,'ESTIMATED_EARNINGS');set('earnings',earnings===null?'—':fmt(earnings));set('currency',currency);set('clicks',metric(d.total,'CLICKS')===null?'—':fmt(d.total.CLICKS));set('views',metric(d.total,'PAGE_VIEWS')===null?'—':fmt(d.total.PAGE_VIEWS));set('impressions',metric(d.total,'IMPRESSIONS')===null?'—':fmt(d.total.IMPRESSIONS));set('ctr',metric(d.total,'PAGE_CTR')===null?'—':(Number(d.total.PAGE_CTR)*100).toFixed(2)+'%');set('rpm',metric(d.total,'PAGE_RPM')===null?'—':fmt(d.total.PAGE_RPM));$('updated').textContent='Diperbarui '+new Date(d.fetchedAt).toLocaleString('id-ID')+' · '+d.period.startDate+' s.d. '+d.period.endDate;await loadAffiliate();const rows=(d.rows||[]).slice().reverse();$('table').innerHTML=rows.length?'<div class="table-wrap"><table class="table"><thead><tr><th>Tanggal</th><th>Pendapatan</th><th>Klik</th><th>Page views</th><th>Impresi</th></tr></thead><tbody>'+rows.map(r=>'<tr><td>'+String(r.DATE||'—')+'</td><td>'+fmt(r.ESTIMATED_EARNINGS)+'</td><td>'+fmt(r.CLICKS)+'</td><td>'+fmt(r.PAGE_VIEWS)+'</td><td>'+fmt(r.IMPRESSIONS)+'</td></tr>').join('')+'</tbody></table></div>':'Tidak ada baris laporan pada periode ini.'}catch(e){$('updated').textContent=e.message;$('table').textContent='Laporan belum tersedia: '+e.message}finally{$('refresh').disabled=false}}
$('connect').addEventListener('click',()=>location.href='/api/cms/google-growth/connect');$('refresh').addEventListener('click',report);$('importCommission').addEventListener('click',importAffiliate);loadStatus();loadAffiliate();const p=new URLSearchParams(location.search);if(p.get('google_connected')==='1'){$('updated').textContent='Izin Google diperbarui. Ambil laporan untuk memeriksa data AdSense.';history.replaceState({},'',location.pathname);loadStatus()}
</script></body></html>