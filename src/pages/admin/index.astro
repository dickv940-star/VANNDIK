---
const pageTitle = 'VANNDIK CMS';
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#05060a" />
  <meta name="description" content="Panel admin resmi VANNDIK untuk mengelola konten dan tampilan website." />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/admin-icon.svg" type="image/svg+xml" />
  <title>{pageTitle}</title>
</head>
<body>
  <div id="authScreen" class="auth-shell">
    <div class="auth-brand"><img src="/admin-icon.svg" alt="" /><span>VANNDIK <b>CMS</b></span></div>
    <div class="auth-card">
      <div class="auth-kicker">CONTROL YOUR DIGITAL ECOSYSTEM</div>
      <h1 id="authTitle">Welcome back.</h1>
      <p id="authDescription">Masuk ke ruang kendali website VANNDIK.</p>
      <form id="loginForm">
        <label>Email admin<input name="email" type="email" autocomplete="username" placeholder="admin@domain.com" required /></label>
        <label>Password<span class="auth-secret-wrap"><input name="password" type="password" autocomplete="current-password" placeholder="Masukkan password" required /><button class="auth-eye-btn" type="button" data-toggle-visibility aria-label="Tampilkan password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></span></label>
        <button class="primary-btn" type="submit">Masuk ke CMS <span>→</span></button>
        <button class="passkey-btn" id="passkeyLogin" type="button"><span>◉</span> Masuk dengan sidik jari / passkey</button>
      </form>
      <form id="setupForm" hidden>
        <div class="setup-note">Aktivasi pertama kali. Buat akun owner utama untuk mengamankan CMS.</div>
        <label>Kode aktivasi<span class="auth-secret-wrap"><input name="setupToken" type="password" autocomplete="off" placeholder="Masukkan kode aktivasi" required /><button class="auth-eye-btn" type="button" data-toggle-visibility aria-label="Tampilkan kode aktivasi" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></span></label>
        <label>Nama admin<input name="displayName" type="text" autocomplete="name" placeholder="Nama administrator" required /></label>
        <label>Email admin<input name="email" type="email" autocomplete="email" placeholder="Email untuk login" required /></label>
        <label>Password baru<span class="auth-secret-wrap"><input name="password" type="password" autocomplete="new-password" minlength="12" placeholder="Minimal 12 karakter" required /><button class="auth-eye-btn" type="button" data-toggle-visibility aria-label="Tampilkan password baru" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button></span></label>
        <button class="primary-btn" type="submit">Buat akun owner <span>→</span></button>
      </form>
      <div id="authMessage" class="auth-message" role="status"></div>
      <div class="auth-foot"><span><i></i> ENCRYPTED ADMIN SESSION</span><span>VANNDIK · 2026</span></div>
    </div>
    <p class="auth-caption">PRIVATE ADMIN AREA · AUTHORIZED ACCESS ONLY</p>
  </div>

  <div id="appShell" class="app-shell" hidden>
    <aside class="sidebar" id="sidebar">
      <a class="side-brand" href="/"><img src="/admin-icon.svg" alt="" /><span>VANNDIK <small>CONTROL CENTER</small></span></a>
      <div class="side-label">WORKSPACE</div>
      <nav id="mainNav">
        <button class="nav-item active" data-view="overview"><span>⌂</span> Ringkasan</button>
        <div class="side-label nav-group-label">CONTENT MANAGEMENT</div>
        <button class="nav-item" data-view="article"><span>▤</span> Artikel <em id="nav-article">0</em></button>
        <button class="nav-item" data-view="news"><span>◷</span> Berita <em id="nav-news">0</em></button>
        <button class="nav-item" data-view="product"><span>◇</span> Produk Affiliate <em id="nav-product">0</em></button>
        <button class="nav-item" data-view="game"><span>▣</span> Game <em id="nav-game">0</em></button>
        <button class="nav-item" data-view="app"><span>▦</span> Aplikasi & Tools <em id="nav-app">0</em></button>
        <div class="side-label nav-group-label">SITE CONTROL</div>
        <button class="nav-item" data-view="themes"><span>◐</span> Tema & Tampilan</button>
        <button class="nav-item" data-view="pages"><span>▧</span> Halaman & Navigasi</button>
        <button class="nav-item" data-view="media"><span>▧</span> Media Library</button>
        <button class="nav-item" data-view="backup"><span>⇩</span> Backup & Restore</button>
        <button class="nav-item" data-view="security"><span>⌑</span> Keamanan Admin</button>
      </nav>
      <div class="sidebar-bottom">
        <div class="system-status"><i></i><span><b>System online</b><small>Cloudflare · D1 Database</small></span></div>
        <a class="visit-site" href="/" target="_blank" rel="noreferrer">Lihat website <span>↗</span></a>
        <button class="profile-mini" id="profileButton"><span class="avatar">VW</span><span><b id="adminName">Administrator</b><small id="adminEmail">admin</small></span><span class="profile-more">···</span></button>
      </div>
    </aside>

    <main class="main-area">
      <header class="topbar">
        <div class="topbar-left"><button class="mobile-menu" id="mobileMenu" aria-label="Buka menu">☰</button><div><div class="top-eyebrow">VANNDIK / ADMINISTRATION</div><div class="top-title" id="topTitle">Ringkasan</div></div></div>
        <div class="topbar-actions"><span class="secure-label"><i></i> SECURE SESSION</span><button class="install-btn" id="installButton" hidden>＋ Install App</button><a class="view-site-btn" href="/" target="_blank" rel="noreferrer">Website ↗</a></div>
      </header>
      <section id="view" class="view-content"></section>
      <footer class="app-footer"><span>VANNDIK CMS <b>·</b> CONTROL CENTER</span><span>BUILT FOR CLARITY. DESIGNED FOR CONTROL.</span></footer>
    </main>
  </div>

  <div id="modalRoot"></div>
  <div id="toast" class="toast" role="status"></div>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
    :root{color-scheme:dark;--bg:#05060a;--panel:#0c111c;--panel2:#101827;--line:#202b3d;--text:#f4f6fb;--muted:#8492a8;--blue:#1769ff;--cyan:#42d9ff;--green:#39ff88;--purple:#a855f7}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px}button,input,textarea,select{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}[hidden]{display:none!important}
    .auth-shell{min-height:100vh;display:grid;place-items:center;padding:32px 18px;background:radial-gradient(ellipse at 50% 15%,#173d7b44,transparent 48%),linear-gradient(135deg,#05060a,#080d18 60%,#090713)}.auth-brand{position:absolute;top:30px;left:36px;display:flex;align-items:center;gap:11px;font:800 15px Manrope;letter-spacing:1px}.auth-brand img{width:34px;height:34px}.auth-brand b{color:var(--cyan)}.auth-card{width:min(450px,100%);padding:38px;border:1px solid #2a3b57;border-radius:14px;background:#0b111deF;box-shadow:0 30px 100px #0008}.auth-kicker,.top-eyebrow,.side-label{font-size:9px;letter-spacing:1.8px;color:#6fbcff;font-weight:700}.auth-card h1{font:800 33px Manrope;letter-spacing:-1.5px;margin:13px 0 7px}.auth-card>p{margin:0 0 26px;color:var(--muted);font-size:12px}.auth-card form{display:grid;gap:15px}.auth-card label,.field{display:grid;gap:7px;color:#bac6d8;font-size:11px}.auth-card input,.field input,.field textarea,.field select{width:100%;min-width:0;border:1px solid #2b3850;border-radius:6px;background:#080e19;color:#f4f6fb;padding:12px 13px;outline:none}.auth-card input:focus,.field input:focus,.field textarea:focus,.field select:focus{border-color:#3d8aff;box-shadow:0 0 0 3px #1769ff20}.auth-secret-wrap{position:relative;display:block;width:100%}.auth-secret-wrap input{padding-right:48px}.auth-eye-btn{position:absolute;top:50%;right:8px;display:grid;place-items:center;width:32px;height:32px;transform:translateY(-50%);border:0;border-radius:5px;background:transparent;color:#91a8c8;cursor:pointer}.auth-eye-btn:hover{background:#1a2a42;color:#fff}.auth-eye-btn:focus-visible{outline:2px solid #42d9ff;outline-offset:1px}.auth-eye-btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.primary-btn{display:flex;justify-content:space-between;align-items:center;margin-top:4px;border:1px solid #438cff;border-radius:6px;padding:13px 15px;background:linear-gradient(100deg,#1769ff,#2558ca);color:#fff;font-weight:700;font-size:12px}.primary-btn span{font-size:17px}.passkey-btn{border:1px solid #2d405e;border-radius:6px;padding:12px;background:#101b2d;color:#dceaff;font-size:11px}.passkey-btn span{margin-right:8px;color:var(--cyan);font-size:17px}.auth-message{min-height:20px;margin-top:12px;color:#ff9c9c;font-size:11px}.auth-message.success{color:var(--green)}.auth-foot{display:flex;justify-content:space-between;gap:10px;margin-top:22px;padding-top:17px;border-top:1px solid #253044;color:#71819b;font-size:8px;letter-spacing:1px}.auth-foot i,.secure-label i,.system-status i{display:inline-block;width:6px;height:6px;margin-right:7px;border-radius:50%;background:var(--green);box-shadow:0 0 9px #39ff88}.auth-caption{position:absolute;bottom:20px;color:#596780;font-size:8px;letter-spacing:2px}.setup-note{padding:12px;border:1px solid #3b6b9b;border-radius:6px;background:#1769ff13;color:#b5d5ff;font-size:11px;line-height:1.6}
    .app-shell{min-height:100vh}.sidebar{position:fixed;z-index:20;inset:0 auto 0 0;width:248px;display:flex;flex-direction:column;padding:23px 15px 15px;border-right:1px solid var(--line);background:#080c14}.side-brand{display:flex;align-items:center;gap:11px;padding:0 9px 26px;font:800 13px Manrope;letter-spacing:.8px}.side-brand img{width:37px;height:37px}.side-brand small{display:block;margin-top:4px;color:#687992;font:600 8px 'DM Sans';letter-spacing:1.8px}.side-label{padding:9px 10px 10px;color:#5f718d;font-size:8px}.nav-group-label{margin-top:19px}.sidebar nav{flex:1;overflow:auto}.nav-item{width:100%;display:flex;align-items:center;gap:11px;padding:10px 11px;margin:2px 0;border:1px solid transparent;border-radius:6px;background:transparent;color:#a1aec1;text-align:left;font-size:11px;transition:.18s}.nav-item>span{width:18px;color:#7e9cc6;font-size:16px;text-align:center}.nav-item em{margin-left:auto;color:#71829b;font-style:normal;font-size:9px}.nav-item:hover{background:#121d30;color:#fff}.nav-item.active{border-color:#28508b;background:#1769ff20;color:#fff}.nav-item.active>span{color:var(--cyan)}.sidebar-bottom{margin-top:15px}.system-status{display:flex;align-items:center;gap:9px;padding:12px;border:1px solid #26364b;border-radius:6px;background:#0c1420}.system-status b,.system-status small,.profile-mini b,.profile-mini small{display:block}.system-status b{font-size:10px}.system-status small{margin-top:4px;color:#71819a;font-size:9px}.visit-site{display:flex;justify-content:space-between;padding:13px 10px;color:#9baec8;font-size:10px}.profile-mini{width:100%;display:flex;align-items:center;gap:9px;padding:12px 4px 2px;border:0;border-top:1px solid var(--line);background:none;color:#e8eef9;text-align:left}.avatar{width:31px;height:31px;display:grid;place-items:center;border-radius:9px;background:linear-gradient(140deg,#1769ff,#7d55df);font:800 10px Manrope}.profile-mini b{font-size:10px}.profile-mini small{margin-top:3px;color:#73839b;font-size:9px}.profile-more{margin-left:auto;color:#8d9bb0;font-size:20px}
    .main-area{min-height:100vh;margin-left:248px;display:flex;flex-direction:column}.topbar{height:75px;position:sticky;top:0;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:0 32px;border-bottom:1px solid var(--line);background:#080c14ed;backdrop-filter:blur(18px)}.topbar-left{display:flex;align-items:center;gap:12px}.top-eyebrow{font-size:8px;color:#6f809b}.top-title{margin-top:4px;font:700 15px Manrope}.topbar-actions{display:flex;align-items:center;gap:17px}.secure-label{color:#8b9ab0;font-size:8px;letter-spacing:1px}.install-btn,.view-site-btn{border:1px solid #30496b;border-radius:5px;padding:9px 12px;background:#12213a;color:#d7e9ff;font-size:10px}.view-site-btn{background:transparent;color:#9bacbf}.mobile-menu{display:none;border:1px solid #2c3c54;border-radius:5px;padding:7px 9px;background:#101827;color:white}.view-content{flex:1;width:100%;max-width:1450px;margin:0 auto;padding:30px 32px 45px}.app-footer{display:flex;justify-content:space-between;gap:12px;padding:17px 32px;border-top:1px solid var(--line);color:#596980;font-size:8px;letter-spacing:1.1px}.app-footer b{color:var(--cyan)}
    .page-head{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:24px}.page-head h1{margin:8px 0 6px;font:800 26px Manrope;letter-spacing:-1px}.page-head p{margin:0;color:var(--muted);font-size:11px}.eyebrow{color:#64baff;font-size:8px;font-weight:700;letter-spacing:1.8px}.action-btn{border:1px solid #3777ce;border-radius:5px;padding:10px 14px;background:#1769ff;color:#fff;font-size:10px;font-weight:700}.action-btn.secondary{border-color:#2a3a52;background:#111a29;color:#cfdaeb}.stats-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.stat-card{position:relative;overflow:hidden;padding:17px;border:1px solid #263349;border-radius:8px;background:linear-gradient(145deg,#101a2a,#0a0f19)}.stat-card:after{content:'';position:absolute;width:80px;height:80px;right:-24px;top:-26px;border:1px solid #1769ff33;border-radius:50%;box-shadow:0 0 0 12px #1769ff08}.stat-label{color:#8a9ab2;font-size:9px}.stat-value{margin:13px 0 4px;font:800 27px Manrope}.stat-sub{color:#687c99;font-size:8px}.stat-icon{position:absolute;right:14px;bottom:14px;color:#42d9ff;font-size:20px}.overview-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:14px;margin-top:16px}.panel{border:1px solid #253247;border-radius:8px;background:#0c121e}.panel-head{display:flex;align-items:center;justify-content:space-between;padding:16px 17px;border-bottom:1px solid #202c40}.panel-head h3{margin:0;font:700 12px Manrope}.panel-head span{color:#74849d;font-size:9px}.quick-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;padding:15px}.quick-card{display:flex;align-items:center;gap:11px;padding:13px;border:1px solid #26374e;border-radius:6px;background:#101a2a;color:#dfeaff;text-align:left}.quick-card:hover{border-color:#3976c4;background:#14233b}.quick-card>span:first-child{width:32px;height:32px;display:grid;place-items:center;border-radius:8px;background:#1769ff24;color:#5cdfff;font-size:17px}.quick-card b{display:block;font-size:10px}.quick-card small{display:block;margin-top:4px;color:#7f90a8;font-size:8px}.activity-list{padding:6px 16px}.activity-item{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid #1c2738}.activity-item:last-child{border:0}.activity-dot{width:7px;height:7px;border-radius:50%;background:#42d9ff;box-shadow:0 0 10px #42d9ff77}.activity-item b{display:block;font-size:10px}.activity-item small{display:block;margin-top:4px;color:#71829a;font-size:8px}.empty-state{padding:30px 15px;color:#8191a9;text-align:center;font-size:10px}
    .table-tools{display:flex;justify-content:space-between;gap:12px;margin-bottom:14px}.search-box{width:min(310px,100%);padding:10px 12px;border:1px solid #29374c;border-radius:5px;background:#0b111c;color:#f4f6fb;outline:0;font-size:10px}.filter-select{padding:9px 11px;border:1px solid #29374c;border-radius:5px;background:#0b111c;color:#b9c6d8;font-size:10px}.content-table{width:100%;border-collapse:collapse}.content-table th{padding:12px 14px;background:#0a101a;color:#74849d;text-align:left;font-size:8px;letter-spacing:1px;font-weight:600}.content-table td{padding:13px 14px;border-top:1px solid #202c40;color:#c8d3e3;font-size:10px}.content-table tr:hover td{background:#111a28}.content-title{font-weight:700;color:#edf4ff}.content-sub{margin-top:4px;color:#72839b;font-size:8px}.status{display:inline-block;padding:5px 8px;border:1px solid #32435b;border-radius:30px;color:#a5b4c8;font-size:8px}.status.published{border-color:#23774b66;background:#39ff8810;color:#63efa1}.status.draft{color:#d6b67b}.status.scheduled{color:#78c7ff}.row-actions{display:flex;gap:6px}.tiny-btn{border:1px solid #30415a;border-radius:4px;padding:6px 8px;background:#101a2a;color:#c6d6ed;font-size:8px}.tiny-btn.danger{color:#ff9a9a}.table-wrap{overflow-x:auto}
    .theme-layout{display:grid;grid-template-columns:1fr 1fr;gap:14px}.theme-preview{min-height:280px;display:flex;flex-direction:column;justify-content:space-between;padding:24px;border:1px solid #2d3d56;border-radius:9px;background:#070b13}.preview-nav{display:flex;justify-content:space-between;align-items:center;font:700 11px Manrope}.preview-logo{color:#fff}.preview-logo b{color:#42d9ff}.preview-hero{padding:25px 0}.preview-hero small{color:#42d9ff;font-size:8px;letter-spacing:2px}.preview-hero h2{max-width:320px;margin:12px 0;font:800 29px/1.1 Manrope}.preview-hero p{max-width:280px;color:#9ba9bd;font-size:10px;line-height:1.7}.preview-cta{display:inline-block;padding:9px 12px;border-radius:4px;background:#1769ff;font-size:9px}.theme-controls{padding:17px}.theme-controls h3{margin:0 0 18px;font:700 13px Manrope}.color-field{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #202c40;color:#aebbd0;font-size:10px}.color-field input{width:42px;height:30px;padding:2px;border:1px solid #40516b;border-radius:5px;background:transparent}.page-select{width:100%;margin-bottom:14px;padding:10px;border:1px solid #2b3b53;border-radius:5px;background:#0a111d;color:#eaf1fc;font-size:10px}
