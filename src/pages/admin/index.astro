  </style>

  <script>
    import { startRegistration, startAuthentication } from '@simplewebauthn/browser';

    const $ = (selector, root = document) => root.querySelector(selector);
    const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
    document.addEventListener('click', event => {
      const button = event.target.closest('[data-toggle-visibility]');
      if (!button) return;
      const input = button.parentElement.querySelector('input');
      if (!input) return;
      const reveal = input.type === 'password';
      input.type = reveal ? 'text' : 'password';
      button.setAttribute('aria-pressed', String(reveal));
      button.setAttribute('aria-label', (reveal ? 'Sembunyikan ' : 'Tampilkan ') + (input.name === 'setupToken' ? 'kode aktivasi' : input.name === 'password' ? 'password' : 'teks'));
      button.innerHTML = reveal
        ? '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a16 16 0 0 1-3.1 3.8M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10 10 0 0 0 4-.8"/></svg>'
        : '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>';
    });
    const authScreen = $('#authScreen'), appShell = $('#appShell'), authMessage = $('#authMessage');
    const view = $('#view'), modalRoot = $('#modalRoot'), toastEl = $('#toast');
    const labels = {overview:'Ringkasan',article:'Artikel',news:'Berita',product:'Produk Affiliate',game:'Game',app:'Aplikasi & Tools',themes:'Tema & Tampilan',pages:'Halaman & Navigasi',media:'Media Library',backup:'Backup & Restore',security:'Keamanan Admin',airoom:'VANNDIK AI Agent Room'};
    let currentAdmin = null, currentType = 'article', settingsCache = {}, installPrompt = null, toastTimer;

    async function api(path, options = {}) {
      const isForm = typeof FormData !== 'undefined' && options.body instanceof FormData;
      const response = await fetch('/api/cms/' + path, { credentials:'same-origin', ...options, headers:{ ...(options.body && !isForm ? {'content-type':'application/json'} : {}), ...(options.headers || {}) } });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Permintaan gagal.');
      return data;
    }
    function notify(message, isError = false) {
      toastEl.textContent = message; toastEl.style.borderColor = isError ? '#9b4646' : '#34547b';
      toastEl.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toastEl.classList.remove('show'), 3200);
    }
    function authNotice(message, success = false) { authMessage.textContent = message || ''; authMessage.classList.toggle('success',success); }
    function showAuth(setup = false) {
      authScreen.hidden = false; appShell.hidden = true;
      $('#loginForm').hidden = setup; $('#setupForm').hidden = !setup;
      $('#authTitle').textContent = setup ? 'Create your access.' : 'Welcome back.';
      $('#authDescription').textContent = setup ? 'Aktivasi pertama untuk mengunci ruang admin.' : 'Masuk ke ruang kendali website VANNDIK.';
      $('#passkeyLogin').hidden = setup; authNotice('');
    }
    function showApp(admin) {
      currentAdmin = admin; authScreen.hidden = true; appShell.hidden = false;
      $('#adminName').textContent = admin.display_name || 'Administrator'; $('#adminEmail').textContent = admin.email;
      $('#profileButton').title = 'Keluar dari CMS'; openView('overview');
      loadStats();
    }
    async function boot() {
      if ('serviceWorker' in navigator) {
        try {
          const registration = await navigator.serviceWorker.register('/admin-sw.js', { scope: '/admin/' });
          watchServiceWorker(registration);
          registration.update().catch(() => {});
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') registration.update().catch(() => {});
          });
        } catch (error) {
          console.warn('CMS offline/update worker unavailable:', error);
        }
      }
      try {
        const setup = await fetch('/api/cms/setup').then(r=>r.json());
        if (setup.setupRequired) return showAuth(true);
        try { const me = await api('me'); if (me.authenticated) return showApp(me.admin); } catch {}
        showAuth(false);
      } catch { showAuth(false); authNotice('Tidak dapat menghubungi server CMS. Coba muat ulang.'); }
    }

    $('#setupForm').addEventListener('submit', async event => {
      event.preventDefault(); const form = new FormData(event.currentTarget);
      try {
        const data = await api('setup',{method:'POST',body:JSON.stringify(Object.fromEntries(form))});
        showApp(data.admin); notify('Akun owner berhasil dibuat.');
      } catch(error) { authNotice(error.message); }
    });
    $('#loginForm').addEventListener('submit', async event => {
      event.preventDefault(); const form = new FormData(event.currentTarget);
      try { const data = await api('login',{method:'POST',body:JSON.stringify(Object.fromEntries(form))}); showApp(data.admin); }
      catch(error) { authNotice(error.message); }
    });
    $('#passkeyLogin').addEventListener('click', async () => {
      const email = $('#loginForm [name=email]').value.trim();
      if (!email) return authNotice('Isi email admin terlebih dahulu.');
      try {
        const options = await api('passkey/login/options',{method:'POST',body:JSON.stringify({email})});
        const response = await startAuthentication({optionsJSON:options});
        const result = await api('passkey/login/verify',{method:'POST',body:JSON.stringify({email,response})});
        showApp(result.admin);
      } catch(error) { authNotice(error.message || 'Login passkey dibatalkan.'); }
    });
    $('#profileButton').addEventListener('click', async () => {
      if (!confirm('Keluar dari VANNDIK CMS?')) return;
      try { await api('logout',{method:'POST',body:'{}'}); } catch {}
      currentAdmin = null; showAuth(false);
    });

    function openView(name) {
      $$('.nav-item').forEach(button => button.classList.toggle('active',button.dataset.view===name));
      $('#topTitle').textContent = labels[name] || 'VANNDIK CMS';
      $('#sidebar').classList.remove('open');
      if (name === 'overview') renderOverview();
      else if (['article','news','product','game','app'].includes(name)) { currentType=name; renderContent(name); }
      else if (name === 'themes') renderThemes();
      else if (name === 'pages') renderPages();
      else if (name === 'media') renderMedia();
      else if (name === 'backup') renderBackup();
      else if (name === 'security') renderSecurity();
      else if (name === 'airoom') renderAiRoom();
    }
    $$( '#mainNav [data-view]' ).forEach(button => button.addEventListener('click',()=>openView(button.dataset.view)));
    $('#sidebarCreate').addEventListener('click',()=>{openView('article');openEditor('article');});
    $('#mobileMenu').addEventListener('click',()=>$('#sidebar').classList.toggle('open'));
    const installButton = $('#installButton');
    const updateButton = $('#updateButton');
    let waitingWorker = null, reloadAfterUpdate = false;
    const isStandalone = () => window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    function syncInstallButton() {
      installButton.hidden = isStandalone();
    }
    syncInstallButton();
    window.addEventListener('appinstalled', () => {
      installPrompt = null;
      installButton.hidden = true;
      notify('VANNDIK CMS berhasil dipasang sebagai aplikasi.');
    });
    window.addEventListener('beforeinstallprompt', event => {
      event.preventDefault();
      installPrompt = event;
      installButton.hidden = false;
    });
    installButton.addEventListener('click', async () => {
      if (installPrompt) {
        installPrompt.prompt();
        const choice = await installPrompt.userChoice;
        installPrompt = null;
        if (choice?.outcome === 'accepted') installButton.hidden = true;
        return;
      }
      const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
      const instructions = isIOS
        ? 'Untuk memasang di iPhone/iPad: ketuk tombol Bagikan di Safari, lalu pilih “Add to Home Screen” / “Tambahkan ke Layar Utama”.'
        : 'Jika tombol instalasi belum muncul, buka menu browser (⋮ atau ⋯), lalu pilih “Install app” atau “Install VANNDIK CMS”. Pastikan browser mendukung instalasi PWA.';
      notify(instructions);
    });
    function watchServiceWorker(registration) {
      const revealUpdate = worker => {
        waitingWorker = worker;
        updateButton.hidden = !worker;
      };
      if (registration.waiting && navigator.serviceWorker.controller) revealUpdate(registration.waiting);
      registration.addEventListener('updatefound', () => {
        const worker = registration.installing;
        if (!worker) return;
        worker.addEventListener('statechange', () => {
          if (worker.state === 'installed' && navigator.serviceWorker.controller) revealUpdate(registration.waiting || worker);
        });
      });
      updateButton.addEventListener('click', () => {
        if (!waitingWorker) return;
        reloadAfterUpdate = true;
        waitingWorker.postMessage({ type: 'SKIP_WAITING' });
        updateButton.disabled = true;
        updateButton.textContent = 'Memperbarui…';
      }, { once: true });
    }
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (reloadAfterUpdate) window.location.reload();
      });
    }

    async function loadStats() {
      try {
        const data=await api('stats');
        Object.keys(data.stats).filter(k=>['article','news','product','game','app'].includes(k)).forEach(k=>{const el=$('#nav-'+k);if(el)el.textContent=data.stats[k]||0;});
      } catch {}
    }
    async function renderOverview() {
      view.innerHTML = `
        <div class="dash-welcome">
          <div><div class="eyebrow">VANNDIK / CONTROL CENTER</div><h1>Selamat datang, ${escapeHTML(currentAdmin?.display_name || 'Admin')}.</h1><p>Pusat kendali konten, katalog, media, dan performa website Anda.</p></div>
          <div class="dash-welcome-actions"><span class="dash-date" id="dashDate"></span><button class="action-btn" id="quickArticle">＋ Buat konten</button></div>
        </div>
        <div class="dash-toolbar"><div class="dash-tabs"><span class="dash-tab active">Overview</span><span class="dash-tab">Content</span><span class="dash-tab">System</span></div><span class="dash-live"><i></i> LIVE WORKSPACE</span></div>
        <div class="dash-stat-grid" id="statsGrid">
          <article class="dash-stat dash-stat-total"><div class="dash-stat-top"><span>Total konten</span><b>◈</b></div><strong>—</strong><small>Seluruh konten CMS</small><div class="dash-spark"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></article>
          <article class="dash-stat"><div class="dash-stat-top"><span>Artikel</span><b>▤</b></div><strong>—</strong><small>Postingan editorial</small><div class="dash-stat-foot"><span class="dash-dot blue"></span> Konten tulisan</div></article>
          <article class="dash-stat"><div class="dash-stat-top"><span>Berita</span><b>◷</b></div><strong>—</strong><small>Informasi terbaru</small><div class="dash-stat-foot"><span class="dash-dot cyan"></span> Update informasi</div></article>
          <article class="dash-stat"><div class="dash-stat-top"><span>Katalog</span><b>◇</b></div><strong>—</strong><small>Produk, game & aplikasi</small><div class="dash-stat-foot"><span class="dash-dot violet"></span> Direktori digital</div></article>
        </div>
        <div class="dash-grid-main">
          <section class="dash-panel dash-performance">
            <div class="dash-panel-head"><div><span class="dash-overline">CONTENT ANALYTICS</span><h2>Komposisi konten</h2><p>Ringkasan jumlah konten di setiap kategori</p></div><span class="dash-period">SEMUA WAKTU</span></div>
            <div class="dash-chart-layout"><div class="dash-donut" id="contentDonut"><div><strong id="contentTotal">0</strong><small>konten</small></div></div><div class="dash-legend" id="contentBreakdown"><div class="empty-state">Memuat distribusi...</div></div></div>
            <div class="dash-bar-chart" id="contentBars"></div>
          </section>
          <section class="dash-panel dash-activity-panel">
            <div class="dash-panel-head"><div><span class="dash-overline">RECENT EVENTS</span><h2>Aktivitas terbaru</h2><p>Jejak aktivitas pada ruang admin</p></div><span class="dash-head-icon">⌁</span></div>
            <div class="dash-activity-list" id="activityList"><div class="empty-state">Memuat aktivitas...</div></div>
          </section>
        </div>
        <div class="dash-grid-bottom">
          <section class="dash-panel">
            <div class="dash-panel-head"><div><span class="dash-overline">WORKSPACE</span><h2>Akses cepat</h2><p>Mulai pekerjaan dari modul utama</p></div><span class="dash-head-icon">↗</span></div>
            <div class="dash-shortcuts">
              <button class="dash-shortcut" data-create="article"><span class="shortcut-icon blue">▤</span><span><b>Tulis artikel</b><small>Buat konten editorial</small></span><em>↗</em></button>
              <button class="dash-shortcut" data-create="news"><span class="shortcut-icon cyan">◷</span><span><b>Terbitkan berita</b><small>Tambahkan informasi baru</small></span><em>↗</em></button>
              <button class="dash-shortcut" data-create="product"><span class="shortcut-icon violet">◇</span><span><b>Tambah affiliate</b><small>Kelola produk & komisi</small></span><em>↗</em></button>
              <button class="dash-shortcut" data-create="game"><span class="shortcut-icon orange">▣</span><span><b>Tambah game</b><small>Kelola katalog game</small></span><em>↗</em></button>
              <button class="dash-shortcut" data-create="app"><span class="shortcut-icon green">▦</span><span><b>Tambah aplikasi</b><small>Direktori aplikasi & tools</small></span><em>↗</em></button>
            </div>
          </section>
          <section class="dash-panel dash-system-panel">
            <div class="dash-panel-head"><div><span class="dash-overline">INFRASTRUCTURE</span><h2>Status sistem</h2><p>Komponen utama VANNDIK CMS</p></div><span class="dash-head-icon">⌘</span></div>
            <div class="dash-system-list"><div><span class="system-symbol">☁</span><span><b>Cloudflare Pages</b><small>Hosting & delivery website</small></span><em class="system-ok"><i></i> ONLINE</em></div><div><span class="system-symbol">▤</span><span><b>D1 Database</b><small>Penyimpanan data CMS</small></span><em class="system-ok"><i></i> READY</em></div><div><span class="system-symbol">▧</span><span><b>Google Drive</b><small>Media & aset website</small></span><em class="system-neutral">CEK DI MEDIA</em></div></div>
            <div class="dash-ai-note"><span class="ai-orbit">✳</span><div><b>AI WORKSPACE</b><small>Ruang kerja tim AI untuk koordinasi, pembagian tugas, diskusi, dan pemantauan pekerjaan.</small></div><span class="dash-coming">ROADMAP</span></div>
          </section>
        </div>`;
      $('#dashDate').textContent = new Intl.DateTimeFormat('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(new Date());
      $('#quickArticle').addEventListener('click',()=>openEditor('article'));
      $$('[data-create]').forEach(button=>button.addEventListener('click',()=>openEditor(button.dataset.create)));
      try {
        const data = await api('stats');
        const categories = [
          {label:'Artikel',key:'article',color:'#438bff',icon:'▤'},
          {label:'Berita',key:'news',color:'#35c8f4',icon:'◷'},
          {label:'Affiliate',key:'product',color:'#9b7bff',icon:'◇'},
          {label:'Game',key:'game',color:'#ffad62',icon:'▣'},
          {label:'Aplikasi & Tools',key:'app',color:'#38d6a3',icon:'▦'}
        ].map(item=>({...item,value:Number(data.stats?.[item.key]||0)}));
        const total = categories.reduce((sum,item)=>sum+item.value,0);
        const catalogue = categories.slice(2).reduce((sum,item)=>sum+item.value,0);
        const cards = [
          {label:'Total konten',value:total,sub:'Seluruh konten CMS',icon:'◈',className:'dash-stat-total'},
          {label:'Artikel',value:categories[0].value,sub:'Postingan editorial',icon:'▤'},
          {label:'Berita',value:categories[1].value,sub:'Informasi terbaru',icon:'◷'},
          {label:'Katalog',value:catalogue,sub:'Produk, game & aplikasi',icon:'◇'}
        ];
        $('#statsGrid').innerHTML = cards.map((item,index)=>'<article class="dash-stat '+(item.className||'')+'"><div class="dash-stat-top"><span>'+item.label+'</span><b>'+item.icon+'</b></div><strong>'+item.value.toLocaleString('id-ID')+'</strong><small>'+item.sub+'</small><div class="dash-stat-foot"><span class="dash-dot '+['blue','blue','cyan','violet'][index]+'"></span> '+(index===0?'INVENTARIS WEBSITE':'DATA TERSIMPAN')+'</div></article>').join('');
        let cursor = 0;
