    /* Editorial workspace inspired by Google Blogger */
    .blogger-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:26px}
    .blogger-head h1{margin:7px 0 5px;color:#17243a;font:800 29px Manrope;letter-spacing:-1px}
    .blogger-head p{margin:0;color:#75859b;font-size:12px;line-height:1.7}
    .blogger-create{border:0;border-radius:7px;padding:12px 18px;background:#1769ff;color:#fff;font-size:11px;font-weight:700;box-shadow:0 5px 14px #1769ff25}
    .blogger-tabs{display:flex;align-items:center;gap:24px;overflow-x:auto;border-bottom:1px solid #dfe6ef;margin-bottom:18px}
    .blogger-tab{flex:0 0 auto;padding:13px 2px 12px;border:0;border-bottom:3px solid transparent;background:transparent;color:#718198;font-size:11px}
    .blogger-tab.active{border-bottom-color:#1769ff;color:#1769ff;font-weight:700}
    .blogger-toolbar{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px}
    .blogger-search{width:min(440px,100%);display:flex;align-items:center;gap:10px;padding:0 13px;border:1px solid #dce5ef;border-radius:7px;background:#fff;color:#8292a8}
    .blogger-search span{font-size:21px}.blogger-search input{width:100%;padding:11px 0;border:0;outline:0;background:transparent;color:#263b56;font:inherit;font-size:11px}
    .blogger-count{color:#8190a5;font-size:10px}
    .blogger-list{overflow:hidden}
    .blogger-list-head,.blogger-post-row{display:grid;grid-template-columns:minmax(280px,1fr) 140px 155px 125px 58px;align-items:center;gap:14px;padding:13px 19px}
    .blogger-list-head{background:#f7f9fc;border-bottom:1px solid #e8edf4;color:#8493a7;font-size:8px;font-weight:700;letter-spacing:1px}
    .blogger-post-row{min-height:93px;border-bottom:1px solid #edf1f6;background:#fff}
    .blogger-post-row:last-child{border-bottom:0}
    .blogger-post-row:hover{background:#fbfdff}
    .blogger-post-main{display:flex;align-items:flex-start;gap:12px;min-width:0}
    .blogger-post-mark{flex:0 0 34px;height:34px;display:grid;place-items:center;border-radius:8px;background:#edf4ff;color:#1769ff;font-size:17px}
    .blogger-post-main>div{min-width:0}
    .blogger-post-title{display:block;max-width:100%;padding:0;border:0;background:transparent;color:#1769c2;text-align:left;font-size:12px;font-weight:700;line-height:1.5;cursor:pointer}
    .blogger-post-title:hover{text-decoration:underline}
    .blogger-post-main p{margin:4px 0 6px;color:#8290a3;font-size:9px;line-height:1.5}
    .blogger-post-actions{display:flex;align-items:center;gap:11px}
    .blogger-post-actions button{padding:0;border:0;background:none;color:#1769c2;font-size:9px;cursor:pointer}
    .blogger-post-actions button.is-danger{color:#d14b4b}
    .blogger-post-actions span{overflow:hidden;color:#9aa6b6;font-size:8px;text-overflow:ellipsis;white-space:nowrap}
    .blogger-label{justify-self:start;max-width:130px;overflow:hidden;padding:5px 9px;border-radius:4px;background:#f0f4f9;color:#61748e;font-size:9px;text-overflow:ellipsis;white-space:nowrap}
    .blogger-date{color:#718198;font-size:9px;line-height:1.5}
    .blogger-status{justify-self:start;padding:5px 8px;border-radius:4px;background:#f0f3f7;color:#74849a;font-size:8px;white-space:nowrap}
    .blogger-status.published{background:#e9f7ef;color:#16834d}.blogger-status.draft{background:#fff5df;color:#9a6a14}.blogger-status.scheduled{background:#eaf3ff;color:#2469b7}
