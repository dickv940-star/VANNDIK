      const coverFile=$('#coverFile',form),coverUrl=$('#coverUrl',form),coverPreview=$('#coverPreview',form),coverFeedback=$('#coverFeedback',form);
      coverFile.addEventListener('change',()=>{const file=coverFile.files?.[0];if(!file)return;if(file.size>8*1024*1024){coverFeedback.textContent='Ukuran file melebihi 8 MB.';coverFile.value='';return;}const localUrl=URL.createObjectURL(file);coverPreview.innerHTML='<img src="'+localUrl+'" alt="Preview gambar cover" />';coverFeedback.textContent=file.name+' siap diupload.';});
      $('#uploadCover',form).addEventListener('click',async()=>{const file=coverFile.files?.[0];if(!file){notify('Pilih gambar cover terlebih dahulu.',true);return;}const button=$('#uploadCover',form);button.disabled=true;coverFeedback.textContent='Mengupload '+file.name+'...';const payload=new FormData();payload.append('file',file,file.name);try{await api('drive/upload',{method:'POST',body:payload});const library=await api('drive/files');const match=(library.items||[]).find(entry=>entry.name===file.name);if(!match?.imageUrl)throw new Error('Upload berhasil, tetapi URL gambar belum ditemukan. Buka Media Library untuk memeriksa file.');coverUrl.value=match.imageUrl;coverPreview.innerHTML='<img src="'+escapeHTML(match.imageUrl)+'" alt="Preview gambar cover" />';coverFeedback.textContent='Berhasil disimpan di Google Drive.';coverFile.value='';notify('Gambar cover berhasil diupload.');}catch(error){coverFeedback.textContent=error.message;notify(error.message,true);}finally{button.disabled=false;}});
      form.addEventListener('submit',async event=>{event.preventDefault();const data=Object.fromEntries(new FormData(form));delete data.cover_file;data.type=type;data.featured=$('input[name=featured]',form).checked;data.sort_order=Number(data.sort_order||0);try{await api(editing?'content/'+item.id:'content',{method:editing?'PUT':'POST',body:JSON.stringify(data)});close();notify('Konten berhasil disimpan.');await renderContent(type);loadStats();}catch(error){notify(error.message,true);}});
    }

