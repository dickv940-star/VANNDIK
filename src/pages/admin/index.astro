  </style>

  <script>
    import { startRegistration, startAuthentication } from '@simplewebauthn/browser';

    const $ = (selector, root = document) => root.querySelector(selector);
    const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
    document.addEventListener('click', event => {
      const button = event.target.closest('[data-toggle-visibility]');
      if (!button) return;
      const input = button.parentElement.querySelector('input');
      if (!input) return;
      const reveal = input.type === 'password';
      input.type = reveal ? 'text' : 'password';
      button.setAttribute('aria-pressed', String(reveal));
      button.setAttribute('aria-label', (reveal ? 'Sembunyikan ' : 'Tampilkan ') + (input.name === 'setupToken' ? 'kode aktivasi' : input.name === 'password' ? 'password' : 'teks'));
      button.innerHTML = reveal
        ? '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a16 16 0 0 1-3.1 3.8M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10 10 0 0 0 4-.8"/></svg>'
        : '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>';
    });
    const authScreen = $('#authScreen'), appShell = $('#appShell'), authMessage = $('#authMessage');
    const view = $('#view'), modalRoot = $('#modalRoot'), toastEl = $('#toast');
    const labels = {overview:'Ringkasan',article:'Artikel',news:'Berita',product:'Produk Affiliate',game:'Game',app:'Aplikasi & Tools',themes:'Tema & Tampilan',pages:'Halaman & Navigasi',media:'Media Library',security:'Keamanan Admin'};
    let currentAdmin = null, currentType = 'article', settingsCache = {}, installPrompt = null, toastTimer;

    async function api(path, options = {}) {
      const isForm = typeof FormData !== 'undefined' && options.body instanceof FormData;
      const response = await fetch('/api/cms/' + path, { credentials:'same-origin', ...options, headers:{ ...(options.body && !isForm ? {'content-type':'application/json'} : {}), ...(options.headers || {}) } });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Permintaan gagal.');
      return data;
    }
    function notify(message, isError = false) {
      toastEl.textContent = message; toastEl.style.borderColor = isError ? '#9b4646' : '#34547b';
      toastEl.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toastEl.classList.remove('show'), 3200);
    }
    function authNotice(message, success = false) { authMessage.textContent = message || ''; authMessage.classList.toggle('success',success); }
    function showAuth(setup = false) {
      authScreen.hidden = false; appShell.hidden = true;
      $('#loginForm').hidden = setup; $('#setupForm').hidden = !setup;
      $('#authTitle').textContent = setup ? 'Create your access.' : 'Welcome back.';
      $('#authDescription').textContent = setup ? 'Aktivasi pertama untuk mengunci ruang admin.' : 'Masuk ke ruang kendali website VANNDIK.';
      $('#passkeyLogin').hidden = setup; authNotice('');
    }
    function showApp(admin) {
      currentAdmin = admin; authScreen.hidden = true; appShell.hidden = false;
      $('#adminName').textContent = admin.display_name || 'Administrator'; $('#adminEmail').textContent = admin.email;
      $('#profileButton').title = 'Keluar dari CMS'; openView('overview');
      loadStats();
    }
    async function boot() {
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/admin-sw.js',{scope:'/admin/'}).catch(()=>{});
      try {
        const setup = await fetch('/api/cms/setup').then(r=>r.json());
        if (setup.setupRequired) return showAuth(true);
        try { const me = await api('me'); if (me.authenticated) return showApp(me.admin); } catch {}
        showAuth(false);
      } catch { showAuth(false); authNotice('Tidak dapat menghubungi server CMS. Coba muat ulang.'); }
    }

    $('#setupForm').addEventListener('submit', async event => {
      event.preventDefault(); const form = new FormData(event.currentTarget);
      try {
        const data = await api('setup',{method:'POST',body:JSON.stringify(Object.fromEntries(form))});
        showApp(data.admin); notify('Akun owner berhasil dibuat.');
      } catch(error) { authNotice(error.message); }
    });
    $('#loginForm').addEventListener('submit', async event => {
      event.preventDefault(); const form = new FormData(event.currentTarget);
      try { const data = await api('login',{method:'POST',body:JSON.stringify(Object.fromEntries(form))}); showApp(data.admin); }
      catch(error) { authNotice(error.message); }
    });
    $('#passkeyLogin').addEventListener('click', async () => {
      const email = $('#loginForm [name=email]').value.trim();
      if (!email) return authNotice('Isi email admin terlebih dahulu.');
      try {
        const options = await api('passkey/login/options',{method:'POST',body:JSON.stringify({email})});
        const response = await startAuthentication({optionsJSON:options});
        const result = await api('passkey/login/verify',{method:'POST',body:JSON.stringify({email,response})});
        showApp(result.admin);
      } catch(error) { authNotice(error.message || 'Login passkey dibatalkan.'); }
    });
    $('#profileButton').addEventListener('click', async () => {
      if (!confirm('Keluar dari VANNDIK CMS?')) return;
      try { await api('logout',{method:'POST',body:'{}'}); } catch {}
      currentAdmin = null; showAuth(false);
    });

    function openView(name) {
      $$('.nav-item').forEach(button => button.classList.toggle('active',button.dataset.view===name));
      $('#topTitle').textContent = labels[name] || 'VANNDIK CMS';
      $('#sidebar').classList.remove('open');
      if (name === 'overview') renderOverview();
      else if (['article','news','product','game','app'].includes(name)) { currentType=name; renderContent(name); }
      else if (name === 'themes') renderThemes();
      else if (name === 'pages') renderPages();
      else if (name === 'media') renderMedia();
      else if (name === 'security') renderSecurity();
    }
    $$('#mainNav [data-view]').forEach(button => button.addEventListener('click',()=>openView(button.dataset.view)));
    $('#mobileMenu').addEventListener('click',()=>$('#sidebar').classList.toggle('open'));
    $('#installButton').addEventListener('click',async()=>{if(!installPrompt)return;installPrompt.prompt();await installPrompt.userChoice;installPrompt=null;$('#installButton').hidden=true;});
    window.addEventListener('beforeinstallprompt',event=>{event.preventDefault();installPrompt=event;$('#installButton').hidden=false;});

    async function loadStats() {
      try {
        const data=await api('stats');
        Object.keys(data.stats).filter(k=>['article','news','product','game','app'].includes(k)).forEach(k=>{const el=$('#nav-'+k);if(el)el.textContent=data.stats[k]||0;});
      } catch {}
    }
    async function renderOverview() {
      view.innerHTML='<div class="page-head"><div><div class="eyebrow">YOUR DIGITAL ECOSYSTEM</div><h1>Selamat datang, '+escapeHTML(currentAdmin?.display_name || 'Admin')+'.</h1><p>Semua kendali konten dan tampilan VANNDIK ada di satu tempat.</p></div><button class="action-btn" id="quickArticle">＋ Buat konten baru</button></div><div class="stats-grid" id="statsGrid"><div class="stat-card"><div class="stat-label">Memuat statistik</div><div class="stat-value">—</div></div></div><div class="overview-grid"><div class="panel"><div class="panel-head"><h3>Quick actions</h3><span>CREATE & MANAGE</span></div><div class="quick-grid"><button class="quick-card" data-create="article"><span>▤</span><span><b>Tulis artikel</b><small>Draft atau publikasi</small></span></button><button class="quick-card" data-create="news"><span>◷</span><span><b>Tambah berita</b><small>Update informasi terbaru</small></span></button><button class="quick-card" data-create="product"><span>◇</span><span><b>Tambah produk</b><small>Kelola tautan affiliate</small></span></button><button class="quick-card" data-create="game"><span>▣</span><span><b>Tambah game</b><small>Katalog permainan</small></span></button></div></div><div class="panel"><div class="panel-head"><h3>Aktivitas admin</h3><span>RECENT LOGS</span></div><div class="activity-list" id="activityList"><div class="empty-state">Memuat aktivitas...</div></div></div></div>';
      $('#quickArticle').addEventListener('click',()=>openEditor('article'));
      $$('[data-create]').forEach(button=>button.addEventListener('click',()=>openEditor(button.dataset.create)));
      try {
        const data=await api('stats');
        const cards=[['Artikel',data.stats.article,'▤'],['Berita',data.stats.news,'◷'],['Affiliate',data.stats.product,'◇'],['Game',data.stats.game,'▣'],['Aplikasi & Tools',data.stats.app,'▦']];
        $('#statsGrid').innerHTML=cards.map((c,i)=>'<div class="stat-card"><div class="stat-label">'+c[0]+'</div><div class="stat-value">'+c[1]+'</div><div class="stat-sub">TOTAL TERSIMPAN</div><span class="stat-icon">'+c[2]+'</span></div>').join('');
        $('#activityList').innerHTML=data.activity.length?data.activity.map(a=>'<div class="activity-item"><i class="activity-dot"></i><span><b>'+escapeHTML(a.action.replaceAll('.',' '))+'</b><small>'+escapeHTML(new Date(a.created_at+'Z').toLocaleString('id-ID'))+'</small></span></div>').join(''):'<div class="empty-state">Belum ada aktivitas. Mulai kelola konten pertamamu.</div>';
      } catch(error) { notify(error.message,true); }
    }
    function escapeHTML(value) { return String(value ?? '').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    const typeNames={article:'Artikel',news:'Berita',product:'Produk Affiliate',game:'Game',app:'Aplikasi & Tools'};
    async function renderContent(type,query='') {
      view.innerHTML='<div class="page-head"><div><div class="eyebrow">CONTENT MANAGEMENT</div><h1>'+typeNames[type]+'</h1><p>Tambah, ubah, atur status, dan kelola konten '+typeNames[type].toLowerCase()+' VANNDIK.</p></div><button class="action-btn" id="addContent">＋ Tambah '+typeNames[type]+'</button></div><div class="table-tools"><input class="search-box" id="contentSearch" type="search" placeholder="Cari judul atau kategori..." value="'+escapeHTML(query)+'" /><select class="filter-select" id="statusFilter"><option value="">Semua status</option><option value="published">Published</option><option value="draft">Draft</option><option value="scheduled">Terjadwal</option><option value="archived">Arsip</option></select></div><div class="panel table-wrap"><table class="content-table"><thead><tr><th>JUDUL KONTEN</th><th>KATEGORI</th><th>STATUS</th><th>DIUBAH</th><th>AKSI</th></tr></thead><tbody id="contentRows"><tr><td colspan="5">Memuat...</td></tr></tbody></table></div>';
      $('#addContent').addEventListener('click',()=>openEditor(type));
      let all=[];
      const draw=()=>{
        const q=$('#contentSearch').value.toLowerCase(), status=$('#statusFilter').value;
        const rows=all.filter(item=>(item.title+' '+item.category).toLowerCase().includes(q)&&(!status||item.status===status));
        $('#contentRows').innerHTML=rows.length?rows.map(item=>'<tr><td><div class="content-title">'+escapeHTML(item.title)+'</div><div class="content-sub">/'+escapeHTML(item.slug)+'</div></td><td>'+escapeHTML(item.category||'—')+'</td><td><span class="status '+item.status+'">'+escapeHTML(item.status)+'</span></td><td>'+escapeHTML(item.updated_at||'—')+'</td><td><div class="row-actions"><button class="tiny-btn" data-edit="'+item.id+'">Edit</button><button class="tiny-btn danger" data-delete="'+item.id+'">Hapus</button></div></td></tr>').join(''):'<tr><td colspan="5"><div class="empty-state">Belum ada konten pada kategori ini.</div></td></tr>';
        $$('[data-edit]').forEach(b=>b.addEventListener('click',()=>openEditor(type,all.find(x=>x.id===b.dataset.edit))));
        $$('[data-delete]').forEach(b=>b.addEventListener('click',async()=>{const item=all.find(x=>x.id===b.dataset.delete);if(!confirm('Hapus konten "'+item.title+'"?'))return;try{await api('content/'+item.id,{method:'DELETE',body:'{}'});notify('Konten dihapus.');await renderContent(type);loadStats();}catch(e){notify(e.message,true);}}));
      };
      $('#contentSearch').addEventListener('input',draw);$('#statusFilter').addEventListener('change',draw);
      try{const data=await api('content?type='+type);all=data.items||[];draw();}catch(e){$('#contentRows').innerHTML='<tr><td colspan="5">'+escapeHTML(e.message)+'</td></tr>';}
    }
    function openEditor(type,item={}) {
      const editing=!!item.id;
      modalRoot.innerHTML='<div class="modal-backdrop"><div class="modal"><div class="modal-head"><h3>'+(editing?'Edit ':'Tambah ')+typeNames[type]+'</h3><button class="close-btn" id="closeModal">×</button></div><form class="modal-form" id="contentForm"><label class="field wide">Judul<input name="title" required maxlength="180" value="'+escapeHTML(item.title||'')+'" /></label><label class="field">Slug URL<input name="slug" value="'+escapeHTML(item.slug||'')+'" placeholder="dibuat-otomatis-dari-judul" /></label><label class="field">Kategori<input name="category" value="'+escapeHTML(item.category||'')+'" placeholder="Kategori konten" /></label><label class="field wide">Ringkasan<textarea name="excerpt" maxlength="600">'+escapeHTML(item.excerpt||'')+'</textarea></label><label class="field wide">Isi / deskripsi<textarea name="body">'+escapeHTML(item.body||'')+'</textarea></label><label class="field wide">URL gambar cover<input name="image_url" type="url" value="'+escapeHTML(item.image_url||'')+'" placeholder="https://... (unggah file tersedia setelah R2 aktif)" /></label><label class="field">Status<select name="status"><option value="draft">Draft</option><option value="published">Published</option><option value="scheduled">Terjadwal</option><option value="archived">Arsip</option></select></label><label class="field">Tanggal publikasi<input name="published_at" type="datetime-local" value="'+(item.published_at||'')+'" /></label><label class="field">Urutan tampil<input name="sort_order" type="number" min="0" value="'+(item.sort_order||0)+'" /></label><label class="field product-fields">Harga / label harga<input name="price" value="'+escapeHTML(item.price||'')+'" placeholder="Contoh: Rp 99.000" /></label><label class="field affiliate-fields">Link affiliate<input name="affiliate_url" type="url" value="'+escapeHTML(item.affiliate_url||'')+'" placeholder="https://..." /></label><label class="field target-fields wide">URL tujuan / demo game / aplikasi<input name="target_url" type="url" value="'+escapeHTML(item.target_url||'')+'" placeholder="https://..." /></label><label class="field"><span><input name="featured" type="checkbox" style="width:auto" '+(item.featured?'checked':'')+' /> Tampilkan sebagai unggulan</span></label><div class="modal-actions"><button class="action-btn secondary" type="button" id="cancelModal">Batal</button><button class="action-btn" type="submit">Simpan konten</button></div></form></div></div>';
      const modal=$('.modal-backdrop',modalRoot), form=$('#contentForm',modalRoot);
      $('select[name=status]',form).value=item.status||'draft';
      $('.product-fields',form).hidden=type!=='product';$('.affiliate-fields',form).hidden=type!=='product';$('.target-fields',form).hidden=!['game','app'].includes(type);
      const titleInput=$('input[name=title]',form),slugInput=$('input[name=slug]',form);
      titleInput.addEventListener('input',()=>{if(!editing)slugInput.value=titleInput.value.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');});
      const close=()=>modalRoot.innerHTML='';$('#closeModal',modalRoot).addEventListener('click',close);$('#cancelModal',modalRoot).addEventListener('click',close);
      form.addEventListener('submit',async event=>{event.preventDefault();const data=Object.fromEntries(new FormData(form));data.type=type;data.featured=$('input[name=featured]',form).checked;data.sort_order=Number(data.sort_order||0);try{await api(editing?'content/'+item.id:'content',{method:editing?'PUT':'POST',body:JSON.stringify(data)});close();notify('Konten berhasil disimpan.');await renderContent(type);loadStats();}catch(e){notify(e.message,true);}});
    }

    function parseSetting(key,fallback={}) { try{return JSON.parse(settingsCache[key]||'');}catch{return fallback;} }
    async function loadSettings(){const data=await api('settings');settingsCache=data.settings||{};return settingsCache;}
    async function saveSettings(settings){await api('settings',{method:'PUT',body:JSON.stringify({settings})});Object.assign(settingsCache,Object.fromEntries(Object.entries(settings).map(([k,v])=>[k,typeof v==='string'?v:JSON.stringify(v)])));notify('Pengaturan berhasil disimpan.');}
    async function renderThemes(){
      try{await loadSettings();}catch(e){notify(e.message,true);}
      const global=parseSetting('theme.global',{mode:'dark',primary:'#1769FF',accent:'#42D9FF',background:'#05060A'});
      view.innerHTML='<div class="page-head"><div><div class="eyebrow">DESIGN SYSTEM</div><h1>Tema & Tampilan</h1><p>Atur identitas visual global atau buat penyesuaian untuk setiap halaman.</p></div><button class="action-btn" id="saveTheme">Simpan tema</button></div><div class="theme-layout"><div class="theme-preview" id="themePreview"><div class="preview-nav"><span class="preview-logo">VANNDIK<span> .</span><b> DIGITAL</b></span><span>Beranda　Tentang　Artikel　Game</span></div><div class="preview-hero"><small>PREMIUM DIGITAL EXPERIENCE</small><h2>Membangun ide menjadi pengalaman digital.</h2><p>Jelajahi dunia digital dalam satu ekosistem yang terhubung.</p><span class="preview-cta">Jelajahi sekarang ↗</span></div><div class="preview-nav"><span>VANNDIK © 2026</span><span>BLACK / BLUE / CYAN</span></div></div><div class="panel theme-controls"><h3>Global design tokens</h3><label class="color-field">Warna utama <input id="themePrimary" type="color" value="'+escapeHTML(global.primary||'#1769FF')+'" /></label><label class="color-field">Warna aksen <input id="themeAccent" type="color" value="'+escapeHTML(global.accent||'#42D9FF')+'" /></label><label class="color-field">Warna latar <input id="themeBackground" type="color" value="'+escapeHTML(global.background||'#05060A')+'" /></label><label class="color-field">Mode tampilan <select id="themeMode" class="filter-select"><option value="dark">Dark premium</option><option value="light">Light minimal</option></select></label><div style="margin-top:18px;color:#8292a9;font-size:9px;line-height:1.7">Warna global menjadi dasar tema website. Tema per halaman dapat menyimpan override khusus.</div></div></div><div class="panel theme-controls" style="margin-top:14px"><h3>Penyesuaian per halaman</h3><select id="themePage" class="page-select"><option value="home">Beranda</option><option value="tentang">Tentang</option><option value="berita">Berita</option><option value="artikel">Artikel</option><option value="produk">Produk</option><option value="game">Game</option><option value="aplikasi">Aplikasi</option></select><div class="color-field">Warna utama halaman <input id="pagePrimary" type="color" value="#1769FF" /></div><div class="color-field">Warna aksen halaman <input id="pageAccent" type="color" value="#42D9FF" /></div><p style="color:#7d8da5;font-size:9px">Override disimpan terpisah untuk setiap halaman dan siap diterapkan ke tampilan publik pada integrasi tema.</p></div>';
      $('#themeMode').value=global.mode||'dark';
      const updatePreview=()=>{$('#themePreview').style.background=$('#themeBackground').value;$('.preview-cta').style.background=$('#themePrimary').value;$('.preview-hero small').style.color=$('#themeAccent').value;};
      ['themePrimary','themeAccent','themeBackground'].forEach(id=>$('#'+id).addEventListener('input',updatePreview));
      $('#themePage').addEventListener('change',()=>{const page=parseSetting('theme.'+$('#themePage').value,{});$('#pagePrimary').value=page.primary||global.primary||'#1769FF';$('#pageAccent').value=page.accent||global.accent||'#42D9FF';});
      $('#themePage').dispatchEvent(new Event('change'));
      $('#saveTheme').addEventListener('click',async()=>{const next={mode:$('#themeMode').value,primary:$('#themePrimary').value,accent:$('#themeAccent').value,background:$('#themeBackground').value};const key='theme.'+$('#themePage').value;const page={primary:$('#pagePrimary').value,accent:$('#pageAccent').value};try{await saveSettings({'theme.global':next,[key]:page});}catch(e){notify(e.message,true);}});
    }
    async function renderPages(){
      try{await loadSettings();}catch(e){}
      const nav=parseSetting('site.navigation',[]),footer=parseSetting('site.footer',{description:'Premium Digital Experience',copyright:'© 2026 VANNDIK'});
      view.innerHTML='<div class="page-head"><div><div class="eyebrow">SITE CONFIGURATION</div><h1>Halaman & Navigasi</h1><p>Kelola menu utama, footer, informasi website, dan bahasa yang tersedia.</p></div><button class="action-btn" id="savePages">Simpan pengaturan</button></div><div class="settings-grid"><div class="panel settings-card"><h3>Navigasi utama</h3><p>Satu baris satu menu, format: Label | URL. Contoh: Beranda | /</p><label class="field">Daftar menu<textarea id="navText">'+escapeHTML((nav.length?nav:[['Beranda','/'],['Tentang','/tentang/'],['Berita','/berita/'],['Artikel','/artikel/'],['Produk','/produk/'],['Aplikasi','/aplikasi/'],['Game','/game/']]).map(x=>Array.isArray(x)?x.join(' | '):x).join('\n'))+'</textarea></label></div><div class="panel settings-card"><h3>Footer & identitas</h3><p>Atur deskripsi singkat dan copyright website.</p><label class="field">Deskripsi footer<textarea id="footerDesc">'+escapeHTML(footer.description||'')+'</textarea></label><label class="field">Copyright<input id="footerCopyright" value="'+escapeHTML(footer.copyright||'')+'" /></label></div><div class="panel settings-card"><h3>Bahasa website</h3><p>Bahasa yang tersedia untuk pengunjung.</p><label class="field">Kode bahasa dipisahkan koma<input id="languageList" value="'+escapeHTML(parseSetting('site.languages',['id','en','jv','su','ms','ja','ko','zh','ar']).join(', '))+'" /></label><small style="color:#7f8ea5;font-size:9px">id, en, jv, su, ms, ja, ko, zh, ar</small></div><div class="panel settings-card"><h3>Kontrol halaman</h3><p>Pengaturan konten dan desain per halaman dapat diakses melalui modul masing-masing.</p><div class="security-row"><span><b>7 halaman utama</b><small>Beranda, Tentang, Berita, Artikel, Produk, Aplikasi, Game</small></span><span class="status published">ACTIVE</span></div><div class="security-row"><span><b>Bahasa default</b><small>Bahasa Indonesia</small></span><span class="status">ID</span></div></div></div>';
      $('#savePages').addEventListener('click',async()=>{const nav=$('#navText').value.split('\n').map(line=>line.split('|').map(x=>x.trim())).filter(x=>x[0]&&x[1]);const languages=$('#languageList').value.split(',').map(x=>x.trim()).filter(Boolean);try{await saveSettings({'site.navigation':nav,'site.footer':{description:$('#footerDesc').value,copyright:$('#footerCopyright').value},'site.languages':languages});}catch(e){notify(e.message,true);}});
    }
    async function renderMedia(){
      view.innerHTML='<div class="page-head"><div><div class="eyebrow">ASSET MANAGEMENT</div><h1>Media Library</h1><p>Penyimpanan media website melalui Google Drive akun dickv940@gmail.com.</p></div><button class="action-btn secondary" id="refreshMedia">↻ Refresh</button></div><div id="driveStatus" class="panel media-status"><div class="empty-state">Memeriksa koneksi Google Drive...</div></div><div id="driveUpload" class="panel media-upload" hidden><div><h3>Upload gambar</h3><p>JPG, PNG, WEBP, GIF, AVIF · maksimal 8 MB per file. File akan disimpan di folder VANNDIK Media.</p></div><div class="media-upload-controls"><input id="mediaFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /><button class="action-btn" id="uploadMedia">Upload ke Drive</button></div><div id="uploadMessage" class="media-help"></div></div><div class="media-library-head"><h3>Galeri media</h3><span id="mediaCount">—</span></div><div id="mediaGallery" class="media-grid"><div class="empty-state">Galeri akan tampil setelah Google Drive terhubung.</div></div>';
      const statusEl=$('#driveStatus'),uploadPanel=$('#driveUpload'),gallery=$('#mediaGallery');
      const loadGallery=async()=>{
        gallery.innerHTML='<div class="empty-state">Memuat galeri...</div>';
        try{
          const data=await api('drive/files');const items=data.items||[];
          $('#mediaCount').textContent=items.length+' gambar';
          gallery.innerHTML=items.length?items.map(item=>'<article class="media-card"><img src="'+escapeHTML(item.imageUrl)+'" alt="'+escapeHTML(item.name)+'" loading="lazy" /><div class="media-card-info"><b title="'+escapeHTML(item.name)+'">'+escapeHTML(item.name)+'</b><small>'+escapeHTML(item.size?Math.max(1,Math.round(Number(item.size)/1024))+' KB':'Google Drive')+'</small><div class="media-card-actions"><button class="tiny-btn" data-copy-media="'+escapeHTML(item.imageUrl)+'">Salin URL</button><button class="tiny-btn danger" data-delete-media="'+escapeHTML(item.id)+'">Hapus</button></div></div></article>').join(''):'<div class="empty-state">Belum ada gambar. Upload gambar pertama Anda.</div>';
          $('[data-copy-media]').forEach(btn=>btn.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(btn.dataset.copyMedia);notify('URL gambar disalin. Tempelkan ke kolom URL gambar konten.');}catch{notify('Browser tidak mengizinkan penyalinan otomatis.',true);}}));
          $('[data-delete-media]').forEach(btn=>btn.addEventListener('click',async()=>{if(!confirm('Hapus gambar ini dari Google Drive? File yang sedang dipakai konten akan ditolak oleh server.'))return;try{await api('drive/files/'+btn.dataset.deleteMedia,{method:'DELETE'});notify('Gambar dihapus dari Drive.');loadGallery();}catch(e){notify(e.message,true);}}));
        }catch(e){gallery.innerHTML='<div class="media-warning">'+escapeHTML(e.message)+'</div>';}
      };
      const loadStatus=async()=>{
        try{
          const data=await api('drive/status');
          if(!data.configured){
            statusEl.innerHTML='<div class="media-warning"><b>Konfigurasi OAuth belum lengkap.</b><br />Tambahkan GOOGLE_DRIVE_CLIENT_ID, GOOGLE_DRIVE_CLIENT_SECRET, dan GOOGLE_DRIVE_TOKEN_KEY sebagai secrets di Cloudflare Pages, lalu deploy ulang.</div>';
            uploadPanel.hidden=true;return;
          }
          if(!data.connected){
            statusEl.innerHTML='<div class="media-connect"><div><b>Google Drive belum terhubung</b><p>Hubungkan akun Google yang ditentukan agar CMS dapat menyimpan media ke folder khusus VANNDIK.</p></div><button class="action-btn" id="connectDrive">Hubungkan Google Drive ↗</button></div>';
            uploadPanel.hidden=true;$('#connectDrive').addEventListener('click',()=>{window.location.href='/api/cms/drive/connect';});return;
          }
          statusEl.innerHTML='<div class="media-connect"><div><b><span class="drive-dot"></span> Google Drive terhubung</b><p>'+escapeHTML(data.email)+' · Folder: '+escapeHTML(data.folderName)+'</p><small>Media publik dapat ditampilkan di halaman website. Token akses disimpan terenkripsi di Cloudflare D1.</small></div><span class="status published">CONNECTED</span></div>';
          uploadPanel.hidden=false;await loadGallery();
        }catch(e){statusEl.innerHTML='<div class="media-warning">'+escapeHTML(e.message)+'</div>';uploadPanel.hidden=true;}
      };
      $('#refreshMedia').addEventListener('click',loadStatus);
      $('#uploadMedia').addEventListener('click',async()=>{
        const file=$('#mediaFile').files?.[0];if(!file){notify('Pilih gambar terlebih dahulu.',true);return;}
        const message=$('#uploadMessage');message.textContent='Mengunggah '+file.name+'...';
        const form=new FormData();form.append('file',file,file.name);
        try{await api('drive/upload',{method:'POST',body:form});message.textContent='Upload berhasil. Gambar sudah tersimpan di Google Drive.';$('#mediaFile').value='';notify('Media berhasil diunggah.');await loadGallery();}
        catch(e){message.textContent=e.message;notify(e.message,true);}
      });
      await loadStatus();
      const params=new URLSearchParams(location.search);
      if(params.get('drive')==='connected'){notify('Google Drive berhasil dihubungkan.');history.replaceState({},'',location.pathname);}
      if(params.has('drive_error')){const messages={wrong_google_account:'Login menggunakan akun dickv940@gmail.com.',consent_denied:'Izin Google Drive tidak diberikan.',oauth_not_configured:'Konfigurasi OAuth belum lengkap.',state_expired:'Sesi koneksi kedaluwarsa. Coba hubungkan kembali.',refresh_token_missing:'Google tidak mengirim refresh token. Coba hubungkan ulang dan setujui akses.',token_exchange_failed:'Google gagal memverifikasi OAuth client.'};notify(messages[params.get('drive_error')]||'Koneksi Google Drive gagal.',true);history.replaceState({},'',location.pathname);}
    }
    async function renderSecurity(){
      view.innerHTML='<div class="page-head"><div><div class="eyebrow">ACCOUNT PROTECTION</div><h1>Keamanan Admin</h1><p>Kelola passkey, biometrik perangkat, dan sesi admin.</p></div></div><div class="panel security-card"><div class="security-row"><span><b>Password admin</b><small>Password disimpan dalam bentuk hash PBKDF2-SHA256, bukan teks asli.</small></span><span class="status published">PROTECTED</span></div><div class="security-row"><span><b>Passkey / biometrik</b><small>Gunakan sidik jari, Face ID, Windows Hello, PIN perangkat, atau security key yang kompatibel.</small></span><button class="action-btn" id="addPasskey">＋ Daftarkan perangkat ini</button></div><div id="passkeyList"><div class="empty-state">Memuat perangkat...</div></div></div><div class="panel security-card" style="margin-top:14px"><h3 style="margin:0 0 8px;font:700 13px Manrope">Tips keamanan</h3><p style="margin:0;color:#8796ac;font-size:10px;line-height:1.8">Gunakan password unik minimal 12 karakter. Daftarkan lebih dari satu passkey bila memungkinkan agar tetap bisa masuk jika salah satu perangkat hilang. Jangan bagikan kode aktivasi atau password.</p></div>';
      $('#addPasskey').addEventListener('click',async()=>{try{const options=await api('passkey/register/options',{method:'POST',body:'{}'});const response=await startRegistration({optionsJSON:options});await api('passkey/register/verify',{method:'POST',body:JSON.stringify({response,deviceName:navigator.userAgent.includes('Android')?'Android device':navigator.userAgent.includes('iPhone')?'iPhone / iPad':'Laptop / desktop'})});notify('Passkey berhasil didaftarkan.');renderSecurity();}catch(e){notify(e.message||'Pendaftaran passkey dibatalkan.',true);}});
      try{const data=await api('passkeys');$('#passkeyList').innerHTML=data.items.length?data.items.map(p=>'<div class="security-row"><span><b>'+escapeHTML(p.device_name||'Perangkat')+'</b><small>Terdaftar '+escapeHTML(p.created_at)+' · terakhir digunakan '+escapeHTML(p.last_used_at||'belum pernah')+'</small></span><button class="tiny-btn danger" data-remove-passkey="'+p.id+'">Hapus</button></div>').join(''):'<div class="empty-state">Belum ada passkey. Tambahkan perangkat untuk login biometrik.</div>';$$('[data-remove-passkey]').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Hapus passkey perangkat ini?'))return;try{await api('passkeys/'+b.dataset.removePasskey,{method:'DELETE',body:'{}'});notify('Passkey dihapus.');renderSecurity();}catch(e){notify(e.message,true);}}));}catch(e){notify(e.message,true);}
    }

    boot();
  </script>
</body>
</html>