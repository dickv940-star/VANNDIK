></label><label class="field">Tanggal publikasi<input name="published_at" type="datetime-local" value="'+(item.published_at||'')+'" /></label><label class="field">Kategori / Label<input name="category" value="'+category+'" placeholder="Contoh: Teknologi" /></label><label class="field">Urutan tampil<input name="sort_order" type="number" min="0" value="'+(item.sort_order||0)+'" /></label><label class="check-field"><input name="featured" type="checkbox" '+(item.featured?'checked':'')+' /> Tampilkan sebagai unggulan</label></section><section class="composer-card cover-card"><h4>Gambar cover</h4><div class="cover-preview" id="coverPreview">'+imagePreview+'</div><label class="upload-drop" for="coverFile"><span>＋</span><b>Pilih gambar dari perangkat</b><small>JPG, PNG, WEBP, GIF · Maks. 8 MB</small><input id="coverFile" name="cover_file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" /></label><button class="action-btn secondary upload-cover-btn" type="button" id="uploadCover">Upload ke Google Drive</button><small class="upload-feedback" id="coverFeedback">Gambar disimpan di Google Drive VANNDIK.</small><label class="field">URL gambar<input name="image_url" id="coverUrl" type="url" value="'+image+'" placeholder="URL akan terisi setelah upload" /></label></section><section class="composer-card '+(type==='product'?'':'is-hidden')+' product-fields"><h4>Affiliate</h4><label class="field">Harga / label harga<input name="price" value="'+escapeHTML(item.price||'')+'" placeholder="Contoh: Rp 99.000" /></label><label class="field">Link affiliate<input name="affiliate_url" type="url" value="'+escapeHTML(item.affiliate_url||'')+'" placeholder="https://..." /></label></section><section class="composer-card '+(['game','app'].includes(type)?'':'is-hidden')+' target-fields"><h4>Link tujuan</h4><label class="field">URL demo / download<input name="target_url" type="url" value="'+escapeHTML(item.target_url||'')+'" placeholder="https://..." /></label></section></aside></form></section></div>';
      const modal=$('.modal-backdrop',modalRoot),form=$('#contentForm',modalRoot);
      $('select[name=status]',form).value=item.status||'draft';
      const titleInput=$('input[name=title]',form),slugInput=$('input[name=slug]',form);
