<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#080c14"><title>Growth Intelligence — VANNDIK</title><style>
:root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;background:#050811;color:#eaf4ff;font-synthesis:none;text-rendering:optimizeLegibility}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 12% -8%,#00e5ff1c,transparent 32%),radial-gradient(ellipse at 90% 8%,#8b5cf61b,transparent 34%),linear-gradient(180deg,#070b16 0%,#050811 55%,#080d19 100%);color:#eaf4ff}
