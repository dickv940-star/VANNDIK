</style></head><body><main class="wrap">
<div class="top"><div class="brand">VANNDIK<span>.</span> INTELLIGENCE</div><div><a href="/admin/growth-settings/">Google Integrations</a>　<a href="/admin/">← Kembali ke CMS</a></div></div>
<div class="eyebrow">GROWTH & REVENUE</div><h1 class="heading">Growth Intelligence</h1><p class="sub">Pantau interaksi tautan affiliate di website. Data ini adalah klik keluar, bukan transaksi atau komisi marketplace.</p>
<div class="toolbar"><select id="range"><option value="7">7 hari</option><option value="30" selected>30 hari</option><option value="90">90 hari</option></select><button id="refresh">Muat ulang data</button><span id="status" class="muted"></span></div>
<section class="grid"><div class="card"><div class="label">Affiliate clicks</div><div class="value" id="total">—</div><div class="hint">Klik keluar tercatat</div></div><div class="card"><div class="label">Produk teratas</div><div class="value" id="topProduct">—</div><div class="hint">Berdasarkan jumlah klik</div></div><div class="card"><div class="label">Negara teratas</div><div class="value" id="topCountry">—</div><div class="hint">Header negara Cloudflare</div></div><div class="card"><div class="label">Marketplace teratas</div><div class="value" id="topMarket">—</div><div class="hint">Hostname tujuan</div></div></section>
<section class="panels"><div class="panel"><h2>Tren klik harian</h2><div class="chart-tabs"><button class="chart-tab active" data-chart="affiliate">Klik affiliate</button></div><div id="daily"><span class="empty">Memuat…</span></div></div><div class="panel"><h2>Marketplace</h2><div class="rows" id="markets"></div></div><div class="panel"><h2>Produk paling banyak diklik</h2><div class="rows" id="products"></div></div><div class="panel"><h2>Negara pengunjung</h2><div class="rows" id="countries"></div></div></section>
<section class="google-grid">
<div class="panel"><h2>Google Analytics 4 · Trafik website</h2><div class="google-kpis" id="gaKpis"><div class="google-empty">Memuat data GA4…</div></div><div class="google-subtitle">Tren performa harian</div><div class="chart-tabs"><button class="chart-tab active" data-chart="ga-users">Pengguna</button><button class="chart-tab" data-chart="ga-sessions">Sesi</button><button class="chart-tab" data-chart="ga-views">Tampilan</button></div><div id="gaTrend"><div class="google-empty">Menunggu data…</div></div><div class="chart-legend"><span><i style="background:#56d5ff"></i>Data harian aktual</span></div><div class="google-subtitle">Halaman terpopuler</div><div class="google-list" id="gaPages"><div class="google-empty">Menunggu data…</div></div><div class="google-source">Sumber: Google Analytics Data API · data aktual properti terhubung</div></div>
<div class="panel"><h2>Google Search Console · Penelusuran</h2><div class="google-kpis" id="scKpis"><div class="google-empty">Memuat data Search Console…</div></div><div class="google-subtitle">Tren performa pencarian</div><div class="chart-tabs"><button class="chart-tab active" data-chart="sc-clicks">Klik</button><button class="chart-tab" data-chart="sc-impressions">Impresi</button></div><div id="scTrend"><div class="google-empty">Menunggu data…</div></div><div class="chart-legend"><span><i style="background:#f5b84b"></i>Data harian aktual</span></div><div class="google-subtitle">Kueri pencarian teratas</div><div class="google-list" id="scQueries"><div class="google-empty">Menunggu data…</div></div><div class="google-subtitle">Halaman teratas dari Google</div><div class="google-list" id="scPages"><div class="google-empty">Menunggu data…</div></div><div class="google-source">Sumber: Google Search Console API · data aktual properti terhubung; data terbaru dapat tertunda</div></div>
</section>
<section class="google-grid"><div class="panel"><h2>YouTube Analytics · Channel & Shorts</h2><div class="google-kpis" id="ytKpis"><div class="google-empty">Memuat YouTube Analytics…</div></div><div class="google-subtitle">Tren performa konten</div><div class="chart-tabs"><button class="chart-tab active" data-chart="yt-views">Views</button><button class="chart-tab" data-chart="yt-likes">Likes</button><button class="chart-tab" data-chart="yt-subs">Subscriber baru</button><button class="chart-tab" data-chart="yt-watch">Waktu tonton (menit)</button></div><div id="ytTrend"><div class="google-empty">Menunggu data…</div></div><div class="google-source">Sumber: YouTube Analytics API · hanya data channel yang diotorisasi</div></div></section>
<section class="google-grid"><div class="panel"><h2>Social Media Analytics · Multi-platform</h2><p class="google-source">Data aktual dari impor CSV laporan platform. API langsung dapat ditambahkan saat akses resmi tersedia.</p><div class="google-kpis" id="socialKpis"><div class="google-empty">Memuat statistik media sosial…</div></div><div class="google-subtitle">Pilih kanal dan metrik</div><div class="toolbar"><select id="socialPlatform"><option value="instagram">Instagram</option><option value="facebook">Facebook</option><option value="youtube">YouTube</option><option value="tiktok">TikTok</option><option value="pinterest">Pinterest</option><option value="linkedin">LinkedIn</option></select><select id="socialMetric"><option value="views">Views</option><option value="reach">Reach</option><option value="impressions">Impressions</option><option value="likes">Likes</option><option value="comments">Comments</option><option value="shares">Shares</option><option value="followers">Followers</option><option value="subscribers">Subscribers</option><option value="clicks">Clicks</option><option value="watch_minutes">Watch minutes</option></select></div><div id="socialTrend"><div class="google-empty">Belum ada data sosial.</div></div><div class="google-source" id="socialImportInfo">Belum ada data impor.</div></div></section>
<div class="panel table-wrap"><h2>Klik terbaru</h2><table class="table"><thead><tr><th>Waktu</th><th>Produk</th><th>Halaman</th><th>Marketplace</th><th>Negara</th></tr></thead><tbody id="recent"><tr><td colspan="5">Memuat…</td></tr></tbody></table></div>
<div class="notice">Privasi: sistem tidak menyimpan alamat IP, nama, email, atau identitas pengunjung. Hubungkan Google Search Console dan GA4 melalui <a href="/admin/growth-settings/">pengaturan integrasi Google</a>. Klik tidak sama dengan pembelian; komisi aktual harus mengikuti laporan affiliate masing-masing platform.</div>
</main>
<script>
const $=id=>document.getElementById(id),fmt=n=>new Intl.NumberFormat('id-ID').format(n||0);
function rows(id,items,key){const root=$(id);if(!items.length){root.innerHTML='<div class="empty">Belum ada data.</div>';return}const max=Math.max(...items.map(x=>+x.clicks||0),1);root.innerHTML=items.map(x=>'<div><div class="rowline"><span>'+String(x[key]||'Unknown').replace(/[&<>"]/g,'')+'</span><b>'+fmt(x.clicks)+'</b></div><div class="track"><i style="width:'+Math.round(x.clicks/max*100)+'%"></i></div></div>').join('')}
const safe=v=>String(v??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
const chartState={ga:[],sc:[],yt:[],social:[],affiliate:[],active:{ga:'ga-users',sc:'sc-clicks',yt:'yt-views',affiliate:'affiliate'}};
function drawLineChart(id,items,getValue,getDate,stroke){
 const root=$(id);if(!items?.length){root.innerHTML='<div class="google-empty">Belum ada data pada periode ini.</div>';return}
 const width=720,height=220,left=48,right=14,top=14,bottom=34,innerW=width-left-right,innerH=height-top-bottom;
 const values=items.map(getValue),max=Math.max(...values,1),min=0;
 const points=values.map((v,i)=>({x:left+(items.length===1?innerW/2:i/(items.length-1)*innerW),y:top+innerH-(v-min)/(max-min||1)*innerH,v,date:getDate(items[i])}));
 const ticks=4;let grid='';
 for(let i=0;i<=ticks;i++){const y=top+i*innerH/ticks,val=Math.round(max*(1-i/ticks));grid+='<line class="chart-grid" x1="'+left+'" y1="'+y+'" x2="'+(width-right)+'" y2="'+y+'"/><text class="chart-axis" x="'+(left-8)+'" y="'+(y+4)+'" text-anchor="end">'+fmt(val)+'</text>'}
 const poly=points.map(p=>p.x+','+p.y).join(' ');
 const dots=points.map(p=>'<circle class="chart-dot" cx="'+p.x+'" cy="'+p.y+'" r="3.5" fill="'+stroke+'"><title>'+safe(p.date)+': '+fmt(p.v)+'</title></circle>').join('');
 const labels=points.filter((p,i)=>i===0||i===points.length-1||i===Math.floor(points.length/2)).map(p=>'<text class="chart-axis" x="'+p.x+'" y="'+(height-8)+'" text-anchor="middle">'+safe(String(p.date).slice(-5))+'</text>').join('');
 root.innerHTML='<svg class="line-chart" viewBox="0 0 '+width+' '+height+'" role="img" aria-label="Grafik tren harian"><g>'+grid+'</g><polyline class="chart-line" stroke="'+stroke+'" points="'+poly+'"/>'+dots+labels+'</svg>';
}
function renderSelectedCharts(){
 const gaMetric=chartState.active.ga,scMetric=chartState.active.sc,ytMetric=chartState.active.yt;
 const gaIndex=gaMetric==='ga-sessions'?1:gaMetric==='ga-views'?2:0;
 drawLineChart('gaTrend',chartState.ga,r=>Number(r.metricValues?.[gaIndex]?.value||0),r=>r.dimensionValues?.[0]?.value,'#56d5ff');
 const scIsImpressions=scMetric==='sc-impressions';
 drawLineChart('scTrend',chartState.sc,r=>Number(scIsImpressions?r.impressions||0:r.clicks||0),r=>r.keys?.[0]||'','#f5b84b');
 const ytKey=ytMetric==='yt-likes'?'likes':ytMetric==='yt-subs'?'subscribersGained':ytMetric==='yt-watch'?'estimatedMinutesWatched':'views';
 drawLineChart('ytTrend',chartState.yt,r=>Number(r[ytKey]||0),r=>r.day||'','#ff6262');
 const socialPlatform=$('socialPlatform')?.value||'instagram',socialMetric=$('socialMetric')?.value||'views';
 const socialRows=chartState.social.filter(r=>r.platform===socialPlatform&&r.metric===socialMetric);
 drawLineChart('socialTrend',socialRows,r=>Number(r.value||0),r=>r.day||'','#a78bfa');
 drawLineChart('daily',chartState.affiliate,r=>Number(r.clicks||0),r=>r.day||'','#56d5ff');
}
function setChartActive(key){
 const group=key.startsWith('ga-')?'ga':key.startsWith('sc-')?'sc':key.startsWith('yt-')?'yt':'affiliate';
 chartState.active[group]=key;
 document.querySelectorAll('[data-chart]').forEach(btn=>btn.classList.toggle('active',btn.dataset.chart===key));
 renderSelectedCharts();
}
document.querySelectorAll('[data-chart]').forEach(btn=>btn.addEventListener('click',()=>setChartActive(btn.dataset.chart)));
function renderSocialSummary(data){const items=data?.items||[],platforms=['instagram','facebook','youtube','tiktok','pinterest','linkedin'];$('socialKpis').innerHTML=platforms.map(platform=>{const metrics=items.filter(x=>x.platform===platform);const latest=(data?.lastImports||[]).find(x=>x.platform===platform);const total=metrics.length;return '<div class="google-kpi"><span>'+platform.toUpperCase()+'</span><b>'+fmt(total)+'</b><small>'+(total?'Titik metrik · impor '+new Date(latest.last_import).toLocaleDateString('id-ID'):'Belum terhubung / belum impor')+'</small></div>'}).join('');const count=(data?.daily||[]).length;$('socialImportInfo').textContent=count?'Tersedia '+fmt(count)+' titik data harian dari laporan yang diimpor.':'Belum ada data CSV. Impor laporan dari Pengaturan Growth.';}
function renderGoogleList(id,items,label,value){const root=$(id);root.innerHTML=items?.length?items.slice(0,7).map(item=>'<div class="google-list-item"><span title="'+safe(label(item))+'">'+safe(label(item))+'</span><b>'+fmt(value(item))+'</b></div>').join(''):'<div class="google-empty">Belum ada data untuk ditampilkan.</div>'}
function renderGoogleReport(data){const ga=data?.analytics,sc=data?.searchConsole,yt=data?.youtube;
$('gaKpis').innerHTML=ga?ga.totals.map(x=>'<div class="google-kpi"><span>'+safe(({users:'Pengguna',sessions:'Sesi',pageViews:'Tampilan halaman'})[x.metric]||x.metric)+'</span><b>'+fmt(x.value)+'</b></div>').join(''):'<div class="google-empty">Data GA4 belum tersedia. Periksa akses properti dan API.</div>';
chartState.ga=ga?.rows||[];
renderGoogleList('gaPages',ga?.topPages||[],r=>r.page,r=>r.views);
$('scKpis').innerHTML=sc?'<div class="google-kpi"><span>Klik</span><b>'+fmt(sc.clicks)+'</b></div><div class="google-kpi"><span>Impresi</span><b>'+fmt(sc.impressions)+'</b></div><div class="google-kpi"><span>CTR rata-rata</span><b>'+(Number(sc.ctr||0)*100).toFixed(1)+'%</b></div><div class="google-kpi"><span>Posisi rata-rata</span><b>'+Number(sc.position||0).toFixed(1)+'</b></div>':'<div class="google-empty">Data Search Console belum tersedia. Periksa izin dan properti.</div>';
chartState.sc=sc?.rows||[];
chartState.yt=yt?.rows||[];
$('ytKpis').innerHTML=yt?'<div class="google-kpi"><span>Views Shorts</span><b>'+fmt(yt.shortsViews)+'</b></div><div class="google-kpi"><span>Waktu tonton</span><b>'+fmt(yt.watchMinutes)+'</b></div><div class="google-kpi"><span>Likes</span><b>'+fmt(yt.likes)+'</b></div><div class="google-kpi"><span>Subscriber baru</span><b>'+fmt(yt.subscribersGained)+'</b></div>':'<div class="google-empty">YouTube belum terhubung atau laporan tidak tersedia.</div>';
renderGoogleList('scQueries',sc?.queries||[],r=>r.keys?.[0]||'(kueri tidak tersedia)',r=>r.clicks);
renderGoogleList('scPages',sc?.pages||[],r=>r.keys?.[0]||'/',r=>r.clicks);
if(data?.warnings?.length){const warning='<div class="google-error">'+data.warnings.map(safe).join(' · ')+'</div>'; $('gaPages').insertAdjacentHTML('afterend',warning)}
}
async function load(){ $('status').textContent='Memuat…';try{const days=$('range').value,[a,b,c]=await Promise.all([fetch('/api/cms/growth/stats?days='+days,{credentials:'same-origin'}),fetch('/api/cms/growth/events',{credentials:'same-origin'}),fetch('/api/cms/growth/social?days='+days,{credentials:'same-origin'})]);if(a.status===401||b.status===401||c.status===401){location.href='/admin/';return}if(!a.ok||!b.ok||!c.ok)throw Error('API tidak dapat dimuat');const d=await a.json(),e=await b.json(),social=await c.json();$('total').textContent=fmt(d.totalClicks);$('topProduct').textContent=d.products[0]?.product_name||'—';$('topCountry').textContent=d.countries[0]?.country||'—';$('topMarket').textContent=d.marketplaces[0]?.marketplace||'—';rows('products',d.products,'product_name');rows('countries',d.countries,'country');rows('markets',d.marketplaces,'marketplace');const ds=d.days||[];chartState.affiliate=ds;chartState.social=social.daily||[];renderSocialSummary(social);renderSelectedCharts();$('recent').innerHTML=e.items.length?e.items.slice(0,30).map(x=>'<tr><td>'+new Date(x.created_at).toLocaleString('id-ID')+'</td><td>'+String(x.product_name||'—').replace(/[&<>"]/g,'')+'</td><td>'+String(x.page_path||'—').replace(/[&<>"]/g,'')+'</td><td>'+String(x.marketplace||'—').replace(/[&<>"]/g,'')+'</td><td>'+String(x.country||'—').replace(/[&<>"]/g,'')+'</td></tr>').join(''):'<tr><td colspan="5">Belum ada klik tercatat.</td></tr>';$('status').textContent='Diperbarui '+new Date().toLocaleTimeString('id-ID')}catch(err){$('status').textContent=err.message;$('status').className='error'}
try{const response=await fetch('/api/cms/google-growth/report?days='+$('range').value,{credentials:'same-origin'});if(response.status===401){location.href='/admin/';return}const report=await response.json();if(!response.ok)throw Error(report.error||'Laporan Google tidak dapat dimuat');renderGoogleReport(report);renderSelectedCharts()}catch(err){$('gaKpis').innerHTML='<div class="google-error">'+safe(err.message)+'</div>';$('scKpis').innerHTML='<div class="google-error">'+safe(err.message)+'</div>';$('ytKpis').innerHTML='<div class="google-error">'+safe(err.message)+'</div>';$('ytTrend').innerHTML='<div class="google-empty">Laporan YouTube tidak tersedia.</div>';$('gaTrend').innerHTML='<div class="google-empty">Laporan tidak tersedia.</div>';$('scTrend').innerHTML='<div class="google-empty">Laporan tidak tersedia.</div>'}}
$('refresh').addEventListener('click',load);$('range').addEventListener('change',load);load();
</script></body></html>