.heading{font-size:clamp(30px,4vw,48px);letter-spacing:-1.8px;margin:12px 0 8px;font-weight:850;background:linear-gradient(100deg,#fff 15%,#b4f5ff 55%,#9d9aff 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
