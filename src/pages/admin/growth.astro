<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#080c14"><title>Growth Intelligence — VANNDIK</title><style>
:root{color-scheme:dark;font-family:Arial,sans-serif;background:#080c14;color:#e9f1ff}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% 0%,#1769ff18,transparent 40%),#080c14;min-height:100vh}.wrap{max-width:1150px;margin:auto;padding:32px 22px 65px}.top{display:flex;justify-content:space-between;margin-bottom:36px}.brand{font-weight:800;letter-spacing:2px}.brand span{color:#55baff}a{color:#9bb4d5;text-decoration:none;font-size:12px}.eyebrow{font-size:9px;letter-spacing:2px;color:#5abaff;font-weight:700}.heading{font-size:38px;margin:10px 0}.sub{color:#91a2bb;font-size:13px;line-height:1.8;max-width:680px}.toolbar{display:flex;gap:10px;align-items:center;margin:24px 0}.toolbar select,.toolbar button{background:#111c2d;border:1px solid #2b3e5a;color:#dceaff;padding:10px 13px;border-radius:7px}.toolbar button{background:#1769ff;cursor:pointer}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.card,.panel{background:linear-gradient(145deg,#111a29,#0c121e);border:1px solid #26364d;border-radius:10px;padding:18px}.label{color:#8fa2bd;font-size:10px}.value{font-size:28px;font-weight:800;margin-top:12px}.hint{font-size:9px;color:#6f849f;margin-top:6px}.panels{display:grid;grid-template-columns:1.3fr 1fr;gap:13px;margin-top:14px}.panel h2{font-size:14px;margin:0 0 16px}.bars{display:flex;align-items:end;gap:7px;height:145px;padding:10px 0 22px;border-bottom:1px solid #2a3a50}.bar-wrap{flex:1;min-width:0;height:100%;display:flex;flex-direction:column;justify-content:end;align-items:center;gap:7px}.bar{width:100%;max-width:25px;border-radius:4px 4px 1px 1px;background:linear-gradient(180deg,#48c9ff,#1769ff);min-height:2px}.bar-wrap small{font-size:8px;color:#71849e}.rows{display:grid;gap:12px}.rowline{display:flex;justify-content:space-between;gap:10px;font-size:11px;color:#b9c9df}.track{height:5px;border-radius:9px;background:#1d2a3e;margin-top:6px;overflow:hidden}.track i{display:block;height:100%;background:linear-gradient(90deg,#1769ff,#55c9ff)}.table-wrap{overflow:auto;margin-top:14px}.table{width:100%;border-collapse:collapse;font-size:10px}.table th,.table td{text-align:left;padding:11px 9px;border-bottom:1px solid #243248;white-space:nowrap}.table th{color:#7f96b5}.table td{color:#c4d2e5}.muted,.empty{color:#7588a3;font-size:11px}.notice{margin-top:18px;padding:14px;border:1px solid #31496a;border-radius:8px;color:#92a8c6;font-size:10px;line-height:1.8}.error{color:#ff9a9a}@media(max-width:800px){.grid{grid-template-columns:repeat(2,1fr)}.panels{grid-template-columns:1fr}}@media(max-width:480px){.wrap{padding:22px 15px}.value{font-size:23px}}
</style></head><body><main class="wrap">
<div class="top"><div class="brand">VANNDIK<span>.</span> INTELLIGENCE</div><a href="/admin/">← Kembali ke CMS</a></div>
<div class="eyebrow">GROWTH & REVENUE</div><h1 class="heading">Growth Intelligence</h1><p class="sub">Pantau interaksi tautan affiliate di website. Data ini adalah klik keluar, bukan transaksi atau komisi marketplace.</p>
<div class="toolbar"><select id="range"><option value="7">7 hari</option><option value="30" selected>30 hari</option><option value="90">90 hari</option></select><button id="refresh">Muat ulang data</button><span id="status" class="muted"></span></div>
<section class="grid"><div class="card"><div class="label">Affiliate clicks</div><div class="value" id="total">—</div><div class="hint">Klik keluar tercatat</div></div><div class="card"><div class="label">Produk teratas</div><div class="value" id="topProduct">—</div><div class="hint">Berdasarkan jumlah klik</div></div><div class="card"><div class="label">Negara teratas</div><div class="value" id="topCountry">—</div><div class="hint">Header negara Cloudflare</div></div><div class="card"><div class="label">Marketplace teratas</div><div class="value" id="topMarket">—</div><div class="hint">Hostname tujuan</div></div></section>
<section class="panels"><div class="panel"><h2>Tren klik harian</h2><div class="bars" id="daily"><span class="empty">Memuat…</span></div></div><div class="panel"><h2>Marketplace</h2><div class="rows" id="markets"></div></div><div class="panel"><h2>Produk paling banyak diklik</h2><div class="rows" id="products"></div></div><div class="panel"><h2>Negara pengunjung</h2><div class="rows" id="countries"></div></div></section>
<div class="panel table-wrap"><h2>Klik terbaru</h2><table class="table"><thead><tr><th>Waktu</th><th>Produk</th><th>Halaman</th><th>Marketplace</th><th>Negara</th></tr></thead><tbody id="recent"><tr><td colspan="5">Memuat…</td></tr></tbody></table></div>
<div class="notice">Privasi: sistem tidak menyimpan alamat IP, nama, email, atau identitas pengunjung. Google Search Console dan GA4 belum terhubung pada tahap ini. Klik tidak sama dengan pembelian; komisi aktual harus mengikuti laporan affiliate masing-masing platform.</div>
</main>
<script>
const $=id=>document.getElementById(id),fmt=n=>new Intl.NumberFormat('id-ID').format(n||0);
function rows(id,items,key){const root=$(id);if(!items.length){root.innerHTML='<div class="empty">Belum ada data.</div>';return}const max=Math.max(...items.map(x=>+x.clicks||0),1);root.innerHTML=items.map(x=>'<div><div class="rowline"><span>'+String(x[key]||'Unknown').replace(/[&<>"]/g,'')+'</span><b>'+fmt(x.clicks)+'</b></div><div class="track"><i style="width:'+Math.round(x.clicks/max*100)+'%"></i></div></div>').join('')}
async function load(){ $('status').textContent='Memuat…';try{const days=$('range').value,[a,b]=await Promise.all([fetch('/api/cms/growth/stats?days='+days,{credentials:'same-origin'}),fetch('/api/cms/growth/events',{credentials:'same-origin'})]);if(a.status===401||b.status===401){location.href='/admin/';return}if(!a.ok||!b.ok)throw Error('API tidak dapat dimuat');const d=await a.json(),e=await b.json();$('total').textContent=fmt(d.totalClicks);$('topProduct').textContent=d.products[0]?.product_name||'—';$('topCountry').textContent=d.countries[0]?.country||'—';$('topMarket').textContent=d.marketplaces[0]?.marketplace||'—';rows('products',d.products,'product_name');rows('countries',d.countries,'country');rows('markets',d.marketplaces,'marketplace');const ds=d.days||[],max=Math.max(...ds.map(x=>x.clicks),1);$('daily').innerHTML=ds.length?ds.map(x=>'<div class="bar-wrap"><div class="bar" title="'+x.clicks+' klik" style="height:'+Math.max(2,Math.round(x.clicks/max*100))+'%"></div><small>'+x.day.slice(5)+'</small></div>').join(''):'<div class="empty">Belum ada klik pada periode ini.</div>';$('recent').innerHTML=e.items.length?e.items.slice(0,30).map(x=>'<tr><td>'+new Date(x.created_at).toLocaleString('id-ID')+'</td><td>'+String(x.product_name||'—').replace(/[&<>"]/g,'')+'</td><td>'+String(x.page_path||'—').replace(/[&<>"]/g,'')+'</td><td>'+String(x.marketplace||'—').replace(/[&<>"]/g,'')+'</td><td>'+String(x.country||'—').replace(/[&<>"]/g,'')+'</td></tr>').join(''):'<tr><td colspan="5">Belum ada klik tercatat.</td></tr>';$('status').textContent='Diperbarui '+new Date().toLocaleTimeString('id-ID')}catch(err){$('status').textContent=err.message;$('status').className='error'}}$('refresh').addEventListener('click',load);$('range').addEventListener('change',load);load();
</script></body></html>