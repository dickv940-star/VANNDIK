</section>
<div class="section-heading"><div><h2>Social & video channels</h2><p>Performa kanal eksternal sesuai data yang tersedia dan diimpor</p></div><span class="section-kicker">04 / Channels</span></div><section class="google-grid"><div class="panel"><h2>YouTube Analytics · Channel & Shorts</h2><div class="google-kpis" id="ytKpis"><div class="google-empty">Memuat YouTube Analytics…</div></div><div class="google-subtitle">Tren performa konten</div><div class="chart-tabs"><button class="chart-tab active" data-chart="yt-views">Views</button><button class="chart-tab" data-chart="yt-likes">Likes</button><button class="chart-tab" data-chart="yt-subs">Subscriber baru</button><button class="chart-tab" data-chart="yt-watch">Waktu tonton (menit)</button></div><div id="ytTrend"><div class="google-empty">Menunggu data…</div></div><div class="google-source">Sumber: YouTube Analytics API · hanya data channel yang diotorisasi</div></div></section>
<section class="google-grid"><div class="panel"><h2>Social Media Analytics · Multi-platform</h2><p class="google-source">Data aktual dari impor CSV laporan platform. API langsung dapat ditambahkan saat akses resmi tersedia.</p><div class="google-kpis" id="socialKpis"><div class="google-empty">Memuat statistik media sosial…</div></div><div class="google-subtitle">Pilih kanal dan metrik</div><div class="toolbar"><select id="socialPlatform"><option value="instagram">Instagram</option><option value="facebook">Facebook</option><option value="youtube">YouTube</option><option value="tiktok">TikTok</option><option value="pinterest">Pinterest</option><option value="linkedin">LinkedIn</option></select><select id="socialMetric"><option value="views">Views</option><option value="reach">Reach</option><option value="impressions">Impressions</option><option value="likes">Likes</option><option value="comments">Comments</option><option value="shares">Shares</option><option value="followers">Followers</option><option value="subscribers">Subscribers</option><option value="clicks">Clicks</option><option value="watch_minutes">Watch minutes</option></select></div><div id="socialTrend"><div class="google-empty">Belum ada data sosial.</div></div><div class="google-source" id="socialImportInfo">Belum ada data impor.</div></div></section>
<div class="section-heading"><div><h2>Aktivitas terbaru</h2><p>Log klik affiliate terbaru yang diterima website</p></div><span class="section-kicker">05 / Activity</span></div><div class="panel table-wrap"><h2>Klik terbaru</h2><table class="table"><thead><tr><th>Waktu</th><th>Produk</th><th>Halaman</th><th>Marketplace</th><th>Negara</th></tr></thead><tbody id="recent"><tr><td colspan="5">Memuat…</td></tr></tbody></table></div>
<div class="notice">Privasi: sistem tidak menyimpan alamat IP, nama, email, atau identitas pengunjung. Hubungkan Google Search Console dan GA4 melalui <a href="/admin/growth-settings/">pengaturan integrasi Google</a>. Klik tidak sama dengan pembelian; komisi aktual harus mengikuti laporan affiliate masing-masing platform.</div>
</main>
<script>
const $=id=>document.getElementById(id),fmt=n=>new Intl.NumberFormat('id-ID').format(n||0);
function rows(id,items,key){const root=$(id);if(!items.length){root.innerHTML='<div class="empty">Belum ada data.</div>';return}const max=Math.max(...items.map(x=>+x.clicks||0),1);root.innerHTML=items.map(x=>'<div><div class="rowline"><span>'+String(x[key]||'Unknown').replace(/[&<>"]/g,'')+'</span><b>'+fmt(x.clicks)+'</b></div><div class="track"><i style="width:'+Math.round(x.clicks/max*100)+'%"></i></div></div>').join('')}
const safe=v=>String(v??'').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
const chartState={ga:[],sc:[],yt:[],social:[],affiliate:[],active:{ga:'ga-users',sc:'sc-clicks',yt:'yt-views',affiliate:'affiliate'}};
function drawLineChart(id,items,getValue,getDate,stroke){
 const root=$(id);
 if(!Array.isArray(items)||!items.length){root.innerHTML='<div class="google-empty">Belum ada data aktual pada periode ini.</div>';return}
 const parseDay=value=>{
  const raw=String(value??'').trim();
  const normalized=/^\\d{8}$/.test(raw)?raw.slice(0,4)+'-'+raw.slice(4,6)+'-'+raw.slice(6,8):raw.slice(0,10);
  const match=normalized.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);
  if(!match)return null;
  const time=Date.UTC(Number(match[1]),Number(match[2])-1,Number(match[3]));
  const check=new Date(time);
  return check.getUTCFullYear()===Number(match[1])&&check.getUTCMonth()===Number(match[2])-1&&check.getUTCDate()===Number(match[3])?time:null;
 };
 const points=items.map(item=>({time:parseDay(getDate(item)),v:Number(getValue(item)),date:String(getDate(item)??'')}))
  .filter(p=>p.time!==null&&Number.isFinite(p.v))
  .sort((a,b)=>a.time-b.time);
 if(!points.length){root.innerHTML='<div class="google-empty">Data tersedia, tetapi format tanggal tidak valid sehingga grafik tidak ditampilkan.</div>';return}
 const width=720,height=220,left=58,right=14,top=14,bottom=36,innerW=width-left-right,innerH=height-top-bottom;
 const minTime=points[0].time,maxTime=points[points.length-1].time,span=Math.max(86400000,maxTime-minTime);
 const max=Math.max(...points.map(p=>p.v),1);
 points.forEach(p=>{p.x=left+(p.time-minTime)/span*innerW;p.y=top+innerH-(p.v/max)*innerH});
 let grid='';
 for(let i=0;i<=4;i++){const y=top+i*innerH/4,val=Math.round(max*(1-i/4));grid+='<line class="chart-grid" x1="'+left+'" y1="'+y+'" x2="'+(width-right)+'" y2="'+y+'"/><text class="chart-axis" x="'+(left-8)+'" y="'+(y+4)+'" text-anchor="end">'+fmt(val)+'</text>'}
 const segments=[];let segment=[];
 for(const point of points){if(segment.length&&point.time-segment[segment.length-1].time>129600000){segments.push(segment);segment=[]}segment.push(point)}
 if(segment.length)segments.push(segment);
 const paths=segments.map(group=>group.length>1?'<polyline class="chart-line" stroke="'+stroke+'" points="'+group.map(p=>p.x+','+p.y).join(' ')+'"/>':'').join('');
 const dots=points.map(p=>'<circle class="chart-dot" cx="'+p.x+'" cy="'+p.y+'" r="3.5" fill="'+stroke+'"><title>'+safe(p.date)+': '+fmt(p.v)+'</title></circle>').join('');
 const labelPoints=[points[0],points[Math.floor((points.length-1)/2)],points[points.length-1]].filter((p,i,a)=>a.findIndex(x=>x.time===p.time)===i);
 const labels=labelPoints.map(p=>'<text class="chart-axis" x="'+p.x+'" y="'+(height-8)+'" text-anchor="middle">'+safe(p.date.slice(5,10)||p.date)+'</text>').join('');
 root.innerHTML='<svg class="line-chart" viewBox="0 0 '+width+' '+height+'" role="img" aria-label="Grafik berdasarkan tanggal data aktual"><g>'+grid+'</g>'+paths+dots+labels+'</svg><div class="google-source">Titik menunjukkan data yang diterima. Jeda tanggal tidak diisi atau diperkirakan.</div>';
}
function renderSelectedCharts(){
 const gaMetric=chartState.active.ga,scMetric=chartState.active.sc,ytMetric=chartState.active.yt;
 const gaIndex=gaMetric==='ga-sessions'?1:gaMetric==='ga-views'?2:0;
 drawLineChart('gaTrend',chartState.ga,r=>Number(r.metricValues?.[gaIndex]?.value||0),r=>r.dimensionValues?.[0]?.value,'#56d5ff');
 const scIsImpressions=scMetric==='sc-impressions';
 drawLineChart('scTrend',chartState.sc,r=>Number(scIsImpressions?r.impressions||0:r.clicks||0),r=>r.keys?.[0]||'','#f5b84b');
 const ytKey=ytMetric==='yt-likes'?'likes':ytMetric==='yt-subs'?'subscribersGained':ytMetric==='yt-watch'?'estimatedMinutesWatched':'views';
 drawLineChart('ytTrend',chartState.yt,r=>Number(r[ytKey]||0),r=>r.day||'','#ff6262');
 const socialPlatform=$('socialPlatform')?.value||'instagram',socialMetric=$('socialMetric')?.value||'views';
 const socialRows=chartState.social.filter(r=>r.platform===socialPlatform&&r.metric===socialMetric);
 drawLineChart('socialTrend',socialRows,r=>Number(r.value||0),r=>r.day||'','#a78bfa');
 drawLineChart('daily',chartState.affiliate,r=>Number(r.clicks||0),r=>r.day||'','#56d5ff');
}
function setChartActive(key){
 const group=key.startsWith('ga-')?'ga':key.startsWith('sc-')?'sc':key.startsWith('yt-')?'yt':'affiliate';
 chartState.active[group]=key;
 document.querySelectorAll('[data-chart]').forEach(btn=>btn.classList.toggle('active',btn.dataset.chart===key));
 renderSelectedCharts();
}
document.querySelectorAll('[data-chart]').forEach(btn=>btn.addEventListener('click',()=>setChartActive(btn.dataset.chart)));
function renderSocialSummary(data){const items=data?.items||[],platforms=['instagram','facebook','youtube','tiktok','pinterest','linkedin'];$('socialKpis').innerHTML=platforms.map(platform=>{const metrics=items.filter(x=>x.platform===platform);const latest=(data?.lastImports||[]).find(x=>x.platform===platform);const total=metrics.length;return '<div class="google-kpi"><span>'+platform.toUpperCase()+'</span><b>'+fmt(total)+'</b><small>'+(total?'jenis metrik tersedia · impor '+(latest?.last_import?new Date(latest.last_import).toLocaleDateString('id-ID'):'tanggal tidak tersedia'):'Belum ada data impor')+'</small></div>'}).join('');const count=(data?.daily||[]).length;$('socialImportInfo').textContent=count?'Tersedia '+fmt(count)+' titik data harian dari laporan yang diimpor.':'Belum ada data CSV. Impor laporan dari Pengaturan Growth.';}
function renderGoogleList(id,items,label,value){const root=$(id);root.innerHTML=items?.length?items.slice(0,7).map(item=>'<div class="google-list-item"><span title="'+safe(label(item))+'">'+safe(label(item))+'</span><b>'+fmt(value(item))+'</b></div>').join(''):'<div class="google-empty">Belum ada data untuk ditampilkan.</div>'}
function renderGoogleReport(data){const ga=data?.analytics,sc=data?.searchConsole,yt=data?.youtube;
$('gaKpis').innerHTML=ga?ga.totals.map(x=>'<div class="google-kpi"><span>'+safe(({users:'Pengguna',sessions:'Sesi',pageViews:'Tampilan halaman'})[x.metric]||x.metric)+'</span><b>'+fmt(x.value)+'</b></div>').join(''):'<div class="google-empty">Data GA4 belum tersedia. Periksa akses properti dan API.</div>';
chartState.ga=ga?.rows||[];
renderGoogleList('gaPages',ga?.topPages||[],r=>r.page,r=>r.views);
$('scKpis').innerHTML=sc?'<div class="google-kpi"><span>Klik</span><b>'+fmt(sc.clicks)+'</b></div><div class="google-kpi"><span>Impresi</span><b>'+fmt(sc.impressions)+'</b></div><div class="google-kpi"><span>CTR rata-rata</span><b>'+(Number(sc.ctr||0)*100).toFixed(1)+'%</b></div><div class="google-kpi"><span>Posisi rata-rata</span><b>'+Number(sc.position||0).toFixed(1)+'</b></div>':'<div class="google-empty">Data Search Console belum tersedia. Periksa izin dan properti.</div>';
chartState.sc=sc?.rows||[];
chartState.yt=yt?.rows||[];
$('ytKpis').innerHTML=yt?'<div class="google-kpi"><span>Views Shorts</span><b>'+fmt(yt.shortsViews)+'</b></div><div class="google-kpi"><span>Waktu tonton</span><b>'+fmt(yt.watchMinutes)+'</b></div><div class="google-kpi"><span>Likes</span><b>'+fmt(yt.likes)+'</b></div><div class="google-kpi"><span>Subscriber baru</span><b>'+fmt(yt.subscribersGained)+'</b></div>':'<div class="google-empty">YouTube belum terhubung atau laporan tidak tersedia.</div>';
renderGoogleList('scQueries',sc?.queries||[],r=>r.keys?.[0]||'(kueri tidak tersedia)',r=>r.clicks);
renderGoogleList('scPages',sc?.pages||[],r=>r.keys?.[0]||'/',r=>r.clicks);
const oldWarning=$('googleWarnings');if(oldWarning)oldWarning.remove();if(data?.warnings?.length){const warning=document.createElement('div');warning.id='googleWarnings';warning.className='google-error';warning.textContent=data.warnings.join(' · ');$('gaPages').insertAdjacentElement('afterend',warning)}
}
async function requestJson(path){
 const response=await fetch(path,{credentials:'same-origin',cache:'no-store'});
 if(response.status===401){location.href='/admin/';throw new Error('Sesi admin berakhir. Silakan login kembali.')}
 const data=await response.json().catch(()=>({}));
 if(!response.ok)throw new Error(data.error||'Permintaan gagal ('+response.status+')');
 return data;
}
function showLoadError(id,message){const root=$(id);if(root)root.innerHTML='<div class="google-error">'+safe(message)+'</div>'}
async function load(){
 const days=$('range').value,states=[];
 $('status').textContent='Memuat sumber data…';$('status').className='muted';
 const jobs=await Promise.allSettled([
  requestJson('/api/cms/growth/stats?days='+days),
  requestJson('/api/cms/growth/events'),
  requestJson('/api/cms/growth/social?days='+days),
  requestJson('/api/cms/google-growth/report?days='+days)
 ]);
 const [affiliateResult,eventsResult,socialResult,googleResult]=jobs;
 if(affiliateResult.status==='fulfilled'){
  const d=affiliateResult.value;
  $('total').textContent=fmt(d.totalClicks);
  $('topProduct').textContent=d.products?.[0]?.product_name||'—';
  $('topCountry').textContent=d.countries?.[0]?.country||'—';
  $('topMarket').textContent=d.marketplaces?.[0]?.marketplace||'—';
  rows('products',d.products||[],'product_name');rows('countries',d.countries||[],'country');rows('markets',d.marketplaces||[],'marketplace');
  chartState.affiliate=d.days||[];states.push('Affiliate OK');
 }else{
  $('total').textContent='—';$('topProduct').textContent='—';$('topCountry').textContent='—';$('topMarket').textContent='—';
  ['products','countries','markets'].forEach(id=>showLoadError(id,affiliateResult.reason?.message||'Data affiliate gagal dimuat'));
  chartState.affiliate=[];states.push('Affiliate: '+(affiliateResult.reason?.message||'gagal'));
 }
 if(eventsResult.status==='fulfilled'){
  const items=eventsResult.value.items||[];
  $('recent').innerHTML=items.length?items.slice(0,30).map(x=>'<tr><td>'+new Date(x.created_at).toLocaleString('id-ID')+'</td><td>'+safe(x.product_name||'—')+'</td><td>'+safe(x.page_path||'—')+'</td><td>'+safe(x.marketplace||'—')+'</td><td>'+safe(x.country||'—')+'</td></tr>').join(''):'<tr><td colspan="5">Belum ada klik tercatat. Klik affiliate akan muncul setelah tracking aktif dan ada pengunjung yang mengekliknya.</td></tr>';
  states.push('Log klik OK');
 }else{
  $('recent').innerHTML='<tr><td colspan="5">'+safe(eventsResult.reason?.message||'Log klik gagal dimuat')+'</td></tr>';
  states.push('Log klik: '+(eventsResult.reason?.message||'gagal'));
 }
 if(socialResult.status==='fulfilled'){
  const social=socialResult.value;chartState.social=social.daily||[];renderSocialSummary(social);states.push('Social OK');
 }else{
  chartState.social=[];showLoadError('socialKpis',socialResult.reason?.message||'Data media sosial gagal dimuat');
  $('socialImportInfo').textContent='Tidak dapat membaca data impor: '+(socialResult.reason?.message||'permintaan gagal');states.push('Social: '+(socialResult.reason?.message||'gagal'));
 }
 if(googleResult.status==='fulfilled'){
  renderGoogleReport(googleResult.value);states.push('Google API OK');
 }else{
  ['gaKpis','scKpis','ytKpis'].forEach(id=>showLoadError(id,googleResult.reason?.message||'Laporan Google gagal dimuat'));
  ['gaTrend','scTrend','ytTrend'].forEach(id=>showLoadError(id,'Laporan belum tersedia. Periksa koneksi dan izin API.'));
  states.push('Google API: '+(googleResult.reason?.message||'gagal'));
 }
 renderSelectedCharts();
 $('status').textContent='Pembaruan '+new Date().toLocaleTimeString('id-ID')+' · '+states.join(' · ');
}$('refresh').addEventListener('click',load);$('range').addEventListener('change',load);load();
</script></body></html>