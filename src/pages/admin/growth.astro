.google-bar-wrap small{font-size:8px;color:#71849e}
.google-subtitle{font-size:10px;color:#7fa4c5;margin:17px 0 9px;letter-spacing:.7px;text-transform:uppercase;font-weight:700}
.google-list{display:grid;gap:0}
.google-list-item{display:flex;justify-content:space-between;gap:10px;font-size:10px;color:#b9c9df;border-bottom:1px solid #192e45;padding:10px 2px}
.google-list-item span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.google-list-item b{color:#e5faff}
.google-empty{font-size:10px;color:#7893ae;padding:15px 2px}
.google-source{font-size:9px;color:#6885a3;margin-top:12px;line-height:1.7}
.chart-tabs{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 10px}
.chart-tab{background:#0a1728;color:#8da9c5;border:1px solid #203c58;padding:7px 10px;border-radius:7px;font-size:9px;font-weight:700;cursor:pointer;transition:.18s}
.chart-tab:hover{border-color:#32cfff;color:#dffaff}
.chart-tab.active{background:linear-gradient(110deg,#103b5b,#24265b);color:#dffaff;border-color:#20cfff;box-shadow:0 0 15px #00cfff22}
.line-chart{width:100%;height:auto;min-height:185px;display:block;overflow:visible;margin-top:3px}
.chart-axis{fill:#7895b3;font-size:10px}.chart-grid{stroke:#203851;stroke-width:1;stroke-dasharray:3 5}
.chart-line{fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 0 5px #26dfff55)}
.chart-dot{stroke:#091421;stroke-width:2;filter:drop-shadow(0 0 4px #28dfff66)}
.chart-legend{display:flex;flex-wrap:wrap;gap:12px;font-size:9px;color:#91a9c2;margin-top:6px}
.chart-legend span{display:flex;align-items:center;gap:5px}.chart-legend i{width:8px;height:8px;border-radius:50%;display:inline-block;box-shadow:0 0 8px currentColor}
.google-error{font-size:10px;color:#ff9fae;margin-top:10px;padding:10px;border:1px solid #693448;background:#26121d;border-radius:8px}
#socialPlatform,#socialMetric{max-width:100%}
