---
import '../styles/global.css';
import '../styles/animations.css';
import vanndikLogo from '../../logo-512.png';
const languages = [
  ['id','🇮🇩','Bahasa Indonesia'],['en','🇬🇧','English'],['jv','🇮🇩','Basa Jawa'],
  ['su','🇮🇩','Basa Sunda'],['ms','🇲🇾','Bahasa Melayu'],['ja','🇯🇵','日本語'],
  ['ko','🇰🇷','한국어'],['zh','🇨🇳','简体中文'],['ar','🇸🇦','العربية']
];
---
<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="description" content="VANNDIK — wawasan, artikel, teknologi, kreativitas, dan rekomendasi pilihan dalam satu ruang digital." />
  <title>VANNDIK — Ide, Wawasan & Inspirasi</title>
  <link rel="icon" type="image/png" href={vanndikLogo.src} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
<div class="editorial-site">
  <header class="editorial-header">
    <a href="/" class="brand" aria-label="VANNDIK Beranda"><img src={vanndikLogo.src} alt="VANNDIK" /></a>
    <nav class="main-nav" id="mainNavigation" aria-label="Navigasi utama">
      <a class="active" href="/">Beranda</a><a href="/artikel/">Artikel</a><a href="/berita/">Berita</a><a href="/produk/">Produk</a><a href="/aplikasi/">Aplikasi</a><a href="/game/">Game</a><a href="/tentang/">Tentang</a>
    </nav>
    <div class="header-tools">
      <div class="language-picker">
        <button id="languageTrigger" type="button" aria-expanded="false" aria-label="Pilih bahasa"><span>◎</span><b id="currentLanguage">ID</b><small>⌄</small></button>
        <div id="languageMenu" class="language-menu" hidden>
          {languages.map(([code,flag,label]) => <button type="button" data-lang={code}><span>{flag}</span>{label}<small>{code.toUpperCase()}</small></button>)}
        </div>
      </div>
      <a class="header-cta" href="/tentang/">Kenali VANNDIK <span>↗</span></a>
      <button class="mobile-toggle" id="mobileMenuToggle" type="button" aria-label="Buka menu" aria-expanded="false"><i></i><i></i></button>
    </div>
  </header>

  <main>
    <section class="welcome">
      <div class="welcome-copy">
        <div class="eyebrow"><span></span> IDEAS · KNOWLEDGE · DIGITAL CULTURE</div>
        <h1>Temukan ide.<br /><em>Perluas perspektif.</em></h1>
        <p>Selamat datang di VANNDIK — ruang digital untuk membaca wawasan, mengikuti perkembangan teknologi, menemukan inspirasi, dan menjelajahi hal-hal baru.</p>
        <div class="welcome-actions"><a class="primary-link" href="/artikel/">Mulai menjelajah <span>↗</span></a><a class="text-link" href="/tentang/">Tentang VANNDIK</a></div>
      </div>
      <div class="welcome-feature">
        <div class="feature-image">
          <div class="feature-image-grid"></div><div class="feature-circle"></div>
          <div class="feature-image-caption"><span>VANNDIK JOURNAL</span><b>Curiosity<br />creates<br /><i>possibility.</i></b><small>READ · EXPLORE · CREATE</small></div>
          <div class="feature-image-index">01 <span>/</span> 04</div>
        </div>
        <div class="feature-caption-row"><span>RUANG UNTUK IDE DAN WAWASAN</span><a href="/artikel/">JELAJAHI ARTIKEL ↗</a></div>
      </div>
    </section>

    <section class="quick-strip" aria-label="Jelajahi kategori">
      <span class="strip-label">JELAJAHI VANNDIK</span>
      <a href="/artikel/">Artikel & Wawasan <span>↗</span></a>
      <a href="/berita/">Berita & Tren <span>↗</span></a>
      <a href="/produk/">Produk Pilihan <span>↗</span></a>
      <a href="/aplikasi/">Tools & Aplikasi <span>↗</span></a>
    </section>

    <section class="content-section latest-section">
      <div class="section-heading">
        <div><div class="eyebrow blue">THE JOURNAL</div><h2>Wawasan terbaru<span>.</span></h2><p>Artikel pilihan untuk menambah pengetahuan dan membuka sudut pandang baru.</p></div>
        <a class="view-all" href="/artikel/">Lihat semua artikel <span>↗</span></a>
      </div>
      <div class="story-layout">
        <a class="lead-story" href="/artikel/">
          <div class="story-art lead-art"><span class="story-tag">EDITORIAL / 01</span><div class="lead-art-orbit"></div><b>THINK<br />BEYOND.</b><small>IDEAS START HERE</small></div>
          <div class="story-info"><div class="story-meta"><span>VANNDIK JOURNAL</span><span>•</span><span>SEGERA HADIR</span></div><h3>Ide, teknologi, dan kreativitas untuk dunia yang terus berubah</h3><p>Ruang editorial VANNDIK untuk mengeksplorasi gagasan dan perkembangan digital.</p><span class="continue-link">Jelajahi koleksi <b>↗</b></span></div>
        </a>
        <div class="side-stories">
          <a class="side-story" href="/artikel/"><div class="side-art side-tech"><span>01</span><b>AI<br />& TECH</b></div><div><span class="story-meta">TEKNOLOGI · SEGERA HADIR</span><h3>Mengenal inovasi yang membentuk masa depan</h3><span class="continue-link">Baca artikel <b>↗</b></span></div></a>
          <a class="side-story" href="/artikel/"><div class="side-art side-create"><span>02</span><b>MAKE<br />IDEAS.</b></div><div><span class="story-meta">KREATIVITAS · SEGERA HADIR</span><h3>Inspirasi untuk mengembangkan ide menjadi karya</h3><span class="continue-link">Baca artikel <b>↗</b></span></div></a>
          <a class="side-story" href="/artikel/"><div class="side-art side-growth"><span>03</span><b>GROW<br />SMART.</b></div><div><span class="story-meta">BISNIS DIGITAL · SEGERA HADIR</span><h3>Perspektif baru tentang peluang di era digital</h3><span class="continue-link">Baca artikel <b>↗</b></span></div></a>
        </div>
      </div>
      <div class="editorial-note">KONTEN EDITORIAL SEDANG DISIAPKAN <span>—</span> Ikuti pembaruan VANNDIK untuk menemukan artikel terbaru.</div>
    </section>

    <section class="content-section explore-section">
      <div class="section-heading">
        <div><div class="eyebrow blue">EXPLORE MORE</div><h2>Jelajahi lebih jauh<span>.</span></h2><p>Temukan berbagai ruang yang dikembangkan di dalam ekosistem VANNDIK.</p></div>
      </div>
      <div class="explore-grid">
        <a class="explore-card explore-news" href="/berita/"><div class="explore-visual"><span class="visual-index">01 / DISCOVER</span><div class="news-symbol">N<span>.</span></div><small>THE WORLD, IN CONTEXT</small></div><div class="explore-copy"><span>STAY INFORMED</span><h3>Berita & Tren</h3><p>Ikuti perkembangan teknologi, bisnis, dan berbagai topik menarik.</p><b>Jelajahi berita ↗</b></div></a>
        <a class="explore-card explore-products" href="/produk/"><div class="explore-visual"><span class="visual-index">02 / CURATED</span><div class="product-symbol">V</div><small>THOUGHTFUL FINDS</small></div><div class="explore-copy"><span>DISCOVER PICKS</span><h3>Produk Pilihan</h3><p>Temukan rekomendasi dan pilihan produk dari berbagai kategori.</p><b>Lihat produk ↗</b></div></a>
        <a class="explore-card explore-tools" href="/aplikasi/"><div class="explore-visual"><span class="visual-index">03 / CREATE</span><div class="tool-symbol">✳</div><small>TOOLS FOR CREATORS</small></div><div class="explore-copy"><span>MAKE SOMETHING</span><h3>Aplikasi & Tools</h3><p>Kenali rangkaian aplikasi kreatif yang sedang dikembangkan.</p><b>Jelajahi aplikasi ↗</b></div></a>
      </div>
    </section>

    <section class="about-band">
      <div class="about-band-inner">
        <div class="about-mark">V.</div>
        <div class="about-copy"><div class="eyebrow">ABOUT VANNDIK</div><h2>Ruang digital untuk<br /><em>rasa ingin tahu.</em></h2><p>VANNDIK menghubungkan ide, informasi, kreativitas, dan teknologi dalam satu pengalaman digital yang terus berkembang.</p><a href="/tentang/">Kenali perjalanan VANNDIK <span>↗</span></a></div>
        <div class="about-aside"><span>OUR POINT OF VIEW</span><b>Stay curious.<br />Keep creating.<br /><i>Move forward.</i></b><small>VANNDIK · EST. 2026</small></div>
      </div>
    </section>

    <section class="closing-section">
      <div><div class="eyebrow blue">KEEP EXPLORING</div><h2>Selalu ada hal baru<br />untuk <em>ditemukan.</em></h2><p>Mulai dari satu artikel, satu ide, atau satu pengalaman baru.</p></div>
      <a class="primary-link" href="/artikel/">Jelajahi VANNDIK <span>↗</span></a>
    </section>
  </main>

  <footer class="editorial-footer">
    <div class="footer-main"><a href="/" class="footer-brand"><img src={vanndikLogo.src} alt="VANNDIK" /></a><p>Ruang digital untuk ide, wawasan,<br />karya, dan kemungkinan baru.</p><div class="footer-links"><a href="/tentang/">Tentang</a><a href="/artikel/">Artikel</a><a href="/berita/">Berita</a><a href="/produk/">Produk</a><a href="/aplikasi/">Aplikasi</a></div></div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} VANNDIK. ALL RIGHTS RESERVED.</span><a href="#top">KEMBALI KE ATAS ↑</a></div>
  </footer>
</div>
<script is:inline>
  const trigger=document.getElementById('languageTrigger');
  const menu=document.getElementById('languageMenu');
  const current=document.getElementById('currentLanguage');
  const options=[...document.querySelectorAll('[data-lang]')];
  const mobileToggle=document.getElementById('mobileMenuToggle');
  const nav=document.getElementById('mainNavigation');
  const saved=localStorage.getItem('vanndik-language')||'id';
  function chooseLanguage(code){
    localStorage.setItem('vanndik-language',code);
    current.textContent=code.toUpperCase();
    document.documentElement.lang=code;
    document.documentElement.dir=code==='ar'?'rtl':'ltr';
    options.forEach(option=>option.classList.toggle('selected',option.dataset.lang===code));
    menu.hidden=true;trigger.setAttribute('aria-expanded','false');
  }
  chooseLanguage(saved);
  trigger.addEventListener('click',()=>{menu.hidden=!menu.hidden;trigger.setAttribute('aria-expanded',String(!menu.hidden));});
  options.forEach(option=>option.addEventListener('click',()=>chooseLanguage(option.dataset.lang)));
  document.addEventListener('click',event=>{if(!event.target.closest('.language-picker')){menu.hidden=true;trigger.setAttribute('aria-expanded','false');}});
  mobileToggle.addEventListener('click',()=>{const open=nav.classList.toggle('open');mobileToggle.setAttribute('aria-expanded',String(open));});
  nav.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{nav.classList.remove('open');mobileToggle.setAttribute('aria-expanded','false');}));
</script>
