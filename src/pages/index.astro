---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b12" />
    <meta name="description" content="VANNDIK — ruang digital untuk ide, karya, teknologi, dan kemungkinan baru." />
    <title>VANNDIK — Premium Digital Experience</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="VANNDIK home">VANNDIK<span>.</span></a>
        <nav class="desktop-nav" aria-label="Navigasi utama">
          <a href="/" aria-current="page">Beranda</a>
          <a href="/tentang/">Tentang</a>
          <a href="/berita/">Berita</a>
          <a href="/artikel/">Artikel</a>
          <a href="/produk/">Produk</a>
          <a href="/aplikasi/">Aplikasi</a>
          <a href="/game/">Game</a>
        </nav>
        <div class="header-actions">
          <div class="language-picker">
            <button class="language-trigger" id="languageTrigger" type="button" aria-expanded="false" aria-label="Choose language">
              <span class="globe-icon">◎</span><span id="currentLanguage">ID</span><span class="chevron">⌄</span>
            </button>
            <div class="language-menu" id="languageMenu" hidden>
              {languages.map((language) => (
                <button class="language-option" type="button" data-lang={language.code}>
                  <span class="language-flag">{language.flag}</span><span>{language.label}</span><span class="language-code">{language.code.toUpperCase()}</span>
                </button>
              ))}
            </div>
          </div>
          <a class="header-cta" href="/produk/">Produk <span>↗</span></a>
          <button class="mobile-menu-toggle" id="mobileMenuToggle" type="button" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
        </div>
      </header>

      <main>
        <section class="hero" id="home">
          <div class="hero-grid"></div>
          <div class="hero-glow hero-glow-one"></div>
          <div class="hero-glow hero-glow-two"></div>
          <div class="hero-content">
            <div class="eyebrow"><span class="eyebrow-dot"></span><span data-i18n="eyebrow">RUANG DIGITAL • IDE • INOVASI</span></div>
            <h1 data-i18n="title">Ide hebat layak mendapat ruang untuk <span class="text-gradient">tumbuh.</span></h1>
            <p class="hero-description" data-i18n="intro">Selamat datang di VANNDIK. Sebuah ruang digital untuk mengeksplorasi ide, karya, teknologi, dan kemungkinan baru.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#explore"><span data-i18n="explore">Jelajahi VANNDIK</span><span class="button-arrow">↗</span></a>
              <a class="button button-quiet" href="#about"><span data-i18n="learn">Kenali lebih jauh</span><span class="quiet-arrow">↓</span></a>
            </div>
            <div class="hero-footnote"><span class="footnote-line"></span><span>INDEPENDENT DIGITAL BRAND</span></div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="orbit orbit-outer"></div><div class="orbit orbit-inner"></div>
            <div class="orbit orbit-dash"></div>
            <div class="orbit-core"><div class="core-inner">V<span>.</span></div></div>
            <div class="orbit-node node-top"></div><div class="orbit-node node-right"></div><div class="orbit-node node-bottom"></div>
            <div class="floating-tag tag-top"><span class="tag-dot"></span> IDEAS IN MOTION</div>
            <div class="floating-tag tag-bottom">EST. <span>VANNDIK</span></div>
          </div>
          <div class="hero-bottom"><span>01 / 03</span><span class="scroll-cue">SCROLL TO EXPLORE <span>↓</span></span><span>EST. VANNDIK</span></div>
        </section>

        <section class="intro-section section-wrap" id="about">
          <div class="section-kicker"><span>01</span><span class="kicker-line"></span><span data-i18n="label">DIBANGUN UNTUK TERUS BERKEMBANG</span></div>
          <div class="intro-layout">
            <h2 data-i18n="sectionTitle">Satu ruang. <span class="text-gradient">Banyak kemungkinan.</span></h2>
            <p data-i18n="sectionIntro">Kami membangun pengalaman digital yang menghubungkan kreativitas, teknologi, dan kebutuhan nyata.</p>
          </div>
        </section>

        <section class="feature-section section-wrap" id="explore">
          <article class="feature-card feature-card-main">
            <div class="feature-number">01 / THINK</div><div class="feature-icon">✳</div>
            <h3 data-i18n="card1">Kreativitas</h3><p data-i18n="desc1">Mengubah gagasan menjadi pengalaman yang bermakna.</p><span class="feature-link">↗</span>
          </article>
          <article class="feature-card">
            <div class="feature-number">02 / BUILD</div><div class="feature-icon">⌘</div>
            <h3 data-i18n="card2">Teknologi</h3><p data-i18n="desc2">Memanfaatkan teknologi untuk solusi yang lebih baik.</p><span class="feature-link">↗</span>
          </article>
          <article class="feature-card">
            <div class="feature-number">03 / GROW</div><div class="feature-icon">◌</div>
            <h3 data-i18n="card3">Eksplorasi</h3><p data-i18n="desc3">Terus belajar, berkembang, dan membuka peluang baru.</p><span class="feature-link">↗</span>
          </article>
        </section>

        <section class="contact-section section-wrap" id="contact">
          <div class="contact-panel">
            <div class="contact-orb"></div>
            <div class="section-kicker"><span>02</span><span class="kicker-line"></span><span>LET'S CONNECT</span></div>
            <h2 data-i18n="contactTitle">Punya ide untuk diwujudkan?</h2>
            <p data-i18n="contactText">Mari mulai percakapan dan temukan kemungkinan berikutnya bersama VANNDIK.</p>
            <a class="button button-primary" href="https://github.com/dickv940-star" target="_blank" rel="noreferrer"><span data-i18n="contact">Hubungi kami</span><span class="button-arrow">↗</span></a>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <a class="wordmark footer-wordmark" href="/">VANNDIK<span>.</span></a>
        <p data-i18n="footer">Ruang digital untuk ide dan kemungkinan baru.</p>
        <div class="footer-meta"><span>© {new Date().getFullYear()} VANNDIK</span><a href="#home">BACK TO TOP ↑</a></div>
      </footer>
    </div>
    <script type="application/json" id="translations" set:html={JSON.stringify(copy)}></script>
    <script is:inline>
      const copy = JSON.parse(document.getElementById('translations')?.textContent || '{}');
      const trigger = document.getElementById('languageTrigger');
      const menu = document.getElementById('languageMenu');
      const current = document.getElementById('currentLanguage');
      const options = document.querySelectorAll('[data-lang]');
      const mobileToggle = document.getElementById('mobileMenuToggle');
      const nav = document.querySelector('.desktop-nav');

      function setLanguage(code) {
        const dictionary = copy[code] || copy.id;
        document.documentElement.lang = code;
        document.documentElement.dir = code === 'ar' ? 'rtl' : 'ltr';
        current.textContent = code.toUpperCase();
        document.querySelectorAll('[data-i18n]').forEach((element) => {
          const key = element.dataset.i18n;
          if (dictionary[key]) element.textContent = dictionary[key];
        });
        options.forEach((option) => option.classList.toggle('is-selected', option.dataset.lang === code));
        localStorage.setItem('vanndik-language', code);
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
      }

      trigger.addEventListener('click', () => {
        menu.hidden = !menu.hidden;
        trigger.setAttribute('aria-expanded', String(!menu.hidden));
      });
      options.forEach((option) => option.addEventListener('click', () => setLanguage(option.dataset.lang)));
      document.addEventListener('click', (event) => {
        if (!event.target.closest('.language-picker')) {
          menu.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
        }
      });
      mobileToggle.addEventListener('click', () => {
        const open = nav.classList.toggle('is-open');
        mobileToggle.setAttribute('aria-expanded', String(open));
      });
      nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        mobileToggle.setAttribute('aria-expanded', 'false');
      }));
      const savedLanguage = localStorage.getItem('vanndik-language');
      if (savedLanguage && copy[savedLanguage]) setLanguage(savedLanguage);
    </script>
  </body>
</html>
