---
import SecondaryLayout from '../layouts/SecondaryLayout.astro';
const topics = ['Untuk Anda','Teknologi','Bisnis Digital','AI & Inovasi','Internet','VANNDIK'];
const sections = [{name:'Teknologi',desc:'Perkembangan teknologi dan produk digital'},{name:'AI & Inovasi',desc:'Kecerdasan buatan, tools, dan kreativitas'},{name:'Bisnis Digital',desc:'Ekonomi kreator, pemasaran, dan tren online'},{name:'Dunia Digital',desc:'Internet, aplikasi, dan keamanan digital'}];
---
<SecondaryLayout title="Berita" description="Ikuti berita terbaru seputar teknologi, kecerdasan buatan, bisnis digital, dan perkembangan industri melalui ringkasan informatif dari VANNDIK." active="/berita/">
<section class="news-head" id="top"><div class="news-width"><div class="brandline"><b class="brand-icon">V.</b> VANNDIK <strong>NEWS</strong><i></i><small>EDISI DIGITAL</small></div><div class="headline"><div><span class="eyebrow">INFORMASI & PERSPEKTIF</span><h1>Berita yang relevan.<br/><span class="text-gradient">Wawasan yang berarti.</span></h1><p>Ikuti perkembangan teknologi, AI, bisnis digital, dan berbagai kabar yang membentuk dunia hari ini.</p></div><aside><span>● RUANG REDAKSI VANNDIK</span><small>Informasi dikurasi untuk pembaca digital</small></aside></div><div class="news-search"><span>⌕</span><input id="newsSearch" type="search" placeholder="Cari berita, topik, atau kata kunci..." aria-label="Cari berita"/><button id="newsSearchButton" type="button">Cari</button></div><nav class="topic-nav">{topics.map((topic,index)=><button type="button" class:list={['topic-chip',{active:index===0}]} data-topic={topic}>{topic}</button>)}</nav></div></section>
<section class="news-main news-width"><div class="section-head"><div><small>SOROTAN REDAKSI</small><h2>Berita utama</h2></div><span>PILIHAN VANNDIK</span></div><div class="lead-grid" id="newsLead"><article class="lead-card"><div class="lead-art"><span>VANNDIK NEWS</span><b>V.</b><small>MEMUAT BERITA CMS</small></div><div class="lead-copy"><h3>Memuat berita terbaru...</h3><p>Berita yang diterbitkan melalui CMS akan tampil otomatis di sini.</p></div></article><aside class="topic-list"><small>JELAJAHI TOPIK</small>{sections.map((s,i)=><a href="#categories"><em>0{i+1}</em><span><b>{s.name}</b><small>{s.desc}</small></span>↗</a>)}</aside></div>
<div class="section-head latest"><div><small>UPDATE & INFORMASI</small><h2>Terbaru untuk Anda</h2></div><span>ALUR BERITA</span></div><div class="news-cards" id="newsCards" aria-live="polite"><p class="cms-loading">Memuat berita dari VANNDIK CMS...</p></div><div class="note" id="newsEmpty" hidden><b>ⓘ</b><p>Belum ada berita yang diterbitkan. Terbitkan berita melalui CMS untuk menampilkannya di sini.</p></div><div class="section-head categories" id="categories"><div><small>BACA BERDASARKAN MINAT</small><h2>Jelajahi kategori</h2></div></div><div class="category-grid">{sections.map((s,i)=><a href="#top"><small>0{i+1}</small><b>{s.name}</b><span>{s.desc}</span><i>↗</i></a>)}</div></section>
<script is:inline>
(()=>{
 const list=document.getElementById('newsCards'),lead=document.getElementById('newsLead'),empty=document.getElementById('newsEmpty'),search=document.getElementById('newsSearch'),buttons=[...document.querySelectorAll('[data-topic]')];
 let items=[],topic='Untuk Anda';
 const txt=v=>String(v||'');
 const href=item=>'/konten/?slug='+encodeURIComponent(item.slug||'');
 const make=(tag,cls,content)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(content!==undefined)e.textContent=content;return e};
 function draw(){
  const q=search.value.trim().toLocaleLowerCase('id-ID');
  const filtered=items.filter(item=>(topic==='Untuk Anda'||topic==='VANNDIK'||txt(item.category).toLocaleLowerCase('id-ID').includes(topic.toLocaleLowerCase('id-ID')))&&(!q||(txt(item.title)+' '+txt(item.excerpt)+' '+txt(item.body)+' '+txt(item.category)+' '+txt(item.tags)).toLocaleLowerCase('id-ID').includes(q)));
  list.replaceChildren();
  filtered.forEach((item,index)=>{
   const card=make('article','');const visual=make('a','news-thumb '+(index%3===1?'violet':index%3===2?'slate':'blue'));visual.href=href(item);visual.style.textDecoration='none';
   const tag=make('span',null,txt(item.category||'BERITA').toUpperCase());const num=make('b',null,String(index+1).padStart(2,'0'));visual.append(tag,num);
   const body=make('div','');const category=make('small',null,txt(item.category||'BERITA').toUpperCase());const title=make('h3',null,item.title);const excerpt=make('p',null,txt(item.excerpt||item.body).slice(0,160));const footer=make('footer',null,item.published_at?new Date(item.published_at).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}):'VANNDIK NEWS');body.append(category,title,excerpt,footer);
   const link=make('a');link.href=href(item);link.style.cssText='color:inherit;text-decoration:none';link.append(body);card.append(visual,link);list.append(card);
  });
  empty.hidden=filtered.length>0;
  const leadCard=lead.querySelector('.lead-card');
  if(filtered.length){
   const first=filtered[0];leadCard.replaceChildren();
   const art=make('a','lead-art');art.href=href(first);art.style.textDecoration='none';art.append(make('span',null,'TOP STORY'),make('b',null,'V.'),make('small',null,txt(first.category||'VANNDIK NEWS').toUpperCase()));
   const copy=make('div','lead-copy');copy.append(make('small',null,'RUANG BERITA'),make('h3',null,first.title),make('p',null,txt(first.excerpt||first.body).slice(0,220)));
   const read=make('a');read.href=href(first);read.textContent='Baca berita ↗';read.style.cssText='margin-top:15px;color:#8db8f8;font-size:11px';copy.append(read);leadCard.append(art,copy);
  }else{
   leadCard.replaceChildren();const art=make('div','lead-art');art.append(make('span',null,'VANNDIK NEWS'),make('b',null,'V.'),make('small',null,'RUANG REDAKSI'));const copy=make('div','lead-copy');copy.append(make('small',null,'RUANG BERITA'),make('h3',null,items.length?'Tidak ada berita yang cocok':'Belum ada berita terbit'),make('p',null,items.length?'Coba topik atau kata kunci lain.':'Berita yang diterbitkan melalui CMS akan tampil otomatis di halaman ini.'));leadCard.append(art,copy);
  }
 }
 buttons.forEach(button=>button.addEventListener('click',()=>{topic=button.dataset.topic;buttons.forEach(item=>item.classList.toggle('active',item===button));draw()}));
 search.addEventListener('input',draw);document.getElementById('newsSearchButton').addEventListener('click',draw);
 fetch('/api/public/content?type=news',{headers:{accept:'application/json'}}).then(async response=>{const data=await response.json();if(!response.ok)throw new Error(data.error||'Gagal memuat berita');return data}).then(data=>{items=Array.isArray(data.items)?data.items:[];draw()}).catch(error=>{list.textContent='Berita belum dapat dimuat: '+error.message;empty.hidden=true});
})();
</script>
<style>
.cms-loading{grid-column:1/-1;padding:25px;text-align:center;color:#91a4bf;border:1px dashed var(--line);font-size:11px}.news-width{width:min(1160px,calc(100% - 48px));margin:0 auto}.news-head{background:radial-gradient(ellipse at 82% 28%,#174b9230,transparent 38%),linear-gradient(130deg,#0d1522,#080b12);border-bottom:1px solid var(--line);padding:42px 0 24px}.brandline{display:flex;align-items:center;gap:9px;font:800 12px Manrope,sans-serif;letter-spacing:1.4px}.brandline strong{color:#83b1ff}.brandline i{height:17px;width:1px;background:#34435b;margin:0 5px}.brandline small{font:600 8px 'DM Sans',sans-serif;letter-spacing:1.7px;color:#7889a3}.brand-icon{display:grid;place-items:center;width:28px;height:28px;border-radius:7px;background:#1769ff;color:white;font-size:15px}.headline{display:flex;align-items:flex-end;justify-content:space-between;gap:25px;padding:48px 0 30px}.eyebrow,.section-head small{font-size:9px;font-weight:700;letter-spacing:2px;color:#83adf3}.headline h1{font:750 clamp(38px,5vw,62px)/1.12 Manrope,sans-serif;letter-spacing:-3px;margin:15px 0}.headline p{font-size:13px;line-height:1.9;color:#9aa8bc;max-width:600px;margin:0}.headline aside{padding-bottom:8px;white-space:nowrap;color:#9eacc0;font-size:8px;letter-spacing:1px}.headline aside span{display:block}.headline aside span:first-letter{color:#78aaff}.headline aside small{display:block;margin-top:8px;color:#6f809a;font-size:9px;letter-spacing:0}.news-search{display:flex;align-items:center;gap:12px;max-width:680px;height:48px;padding:0 7px 0 16px;border:1px solid #293b56;border-radius:6px;background:#111b2a}.news-search>span{font-size:23px;color:#83a9e4}.news-search input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#eaf1fc;font:12px 'DM Sans',sans-serif}.news-search input::placeholder{color:#77869c}.news-search button{height:34px;padding:0 17px;border:0;border-radius:4px;background:#1769ff;color:white;font-size:10px;font-weight:700;cursor:pointer}.topic-nav{display:flex;gap:9px;overflow:auto;padding:22px 0 0;scrollbar-width:none}.topic-chip{white-space:nowrap;border:1px solid #29374d;background:#111a28;color:#9ba9bd;border-radius:30px;padding:9px 15px;font-size:10px;cursor:pointer}.topic-chip.active,.topic-chip:hover{background:#17335c;border-color:#326ab1;color:#fff}.news-main{padding:50px 0 80px}.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px}.section-head h2{font:700 25px Manrope,sans-serif;letter-spacing:-1px;margin:8px 0 0}.section-head>span{font-size:8px;letter-spacing:1.5px;color:#71829a}.lead-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,.8fr);gap:18px}.lead-card{overflow:hidden;display:grid;grid-template-columns:1.08fr 1fr;border:1px solid var(--line);border-radius:8px;background:#0e1725;min-height:290px}.lead-art{position:relative;display:grid;place-items:center;overflow:hidden;background:radial-gradient(circle at 50% 45%,#245a9c,#142b4b 45%,#0d1728)}.lead-art:before,.lead-art:after{content:'';position:absolute;width:260px;height:260px;border:1px solid #9dc5ff35;border-radius:50%}.lead-art:after{width:190px;height:190px}.lead-art b{display:grid;place-items:center;width:86px;height:86px;border-radius:24px;background:linear-gradient(145deg,#4089ff,#16468b);box-shadow:0 0 65px #4b91ff80;font:800 35px Manrope;color:white;z-index:1}.lead-art span,.lead-art small{position:absolute;z-index:2;left:20px;top:18px;color:#d2e5ff;font-size:8px;letter-spacing:2px}.lead-art small{top:auto;bottom:18px;color:#9cb7dc}.lead-copy{padding:27px;display:flex;flex-direction:column;justify-content:center}.lead-copy>small,.news-cards article>div:last-child>small{font-size:8px;letter-spacing:1.6px;font-weight:700;color:#82adf3}.lead-copy h3{font:700 21px/1.3 Manrope,sans-serif;margin:12px 0}.lead-copy p,.news-cards p{font-size:10px;line-height:1.9;color:#95a4b9}.lead-copy footer,.news-cards footer{margin-top:15px;color:#71829a;font-size:8px}.topic-list{padding:20px;border:1px solid var(--line);border-radius:8px;background:#0e1725}.topic-list>small{display:block;font-size:8px;letter-spacing:1.8px;color:#8193ad;padding-bottom:13px;border-bottom:1px solid var(--line)}.topic-list a{display:flex;align-items:center;gap:12px;padding:16px 0;border-bottom:1px solid #ffffff0c;color:#7899c6;font-size:12px}.topic-list a:last-child{border:0}.topic-list em{font:600 11px Manrope;color:#6d9de5;font-style:normal}.topic-list a span{display:flex;flex-direction:column;gap:5px}.topic-list b{font-size:11px;color:#e2eaf6}.topic-list a small{font-size:9px;color:#7e8da4}.latest{margin-top:54px}.news-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.news-cards article{overflow:hidden;border:1px solid var(--line);border-radius:7px;background:#0e1725}.news-cards article>div:last-child{padding:18px}.news-thumb{height:145px;position:relative;display:flex;align-items:flex-end;justify-content:space-between;padding:17px;background:linear-gradient(135deg,#173d6a,#142239 60%,#0d1522)}.news-thumb:before{content:'';position:absolute;width:145px;height:145px;border:1px solid #9ec6ff35;border-radius:50%;right:13%;top:-45px;box-shadow:0 0 0 22px #9ec6ff08,0 0 0 45px #9ec6ff06}.news-thumb span,.news-thumb b{position:relative;color:#b9d4fa;font-size:8px;letter-spacing:2px}.news-thumb b{font:700 22px Manrope;color:#ffffff77}.news-thumb.violet{background:linear-gradient(135deg,#352e68,#1d2341,#111827)}.news-thumb.slate{background:linear-gradient(135deg,#31536a,#1a3040,#111a26)}.news-cards h3{font:650 15px Manrope;margin:9px 0}.news-cards p{margin:0}.note{display:flex;gap:10px;margin-top:19px;padding:13px 15px;border-left:2px solid #2878ff;background:#101a2a;color:#91a4bf}.note b{color:#83adf3}.note p{font-size:10px;line-height:1.8;margin:0}.categories{margin-top:53px}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.category-grid a{position:relative;display:flex;flex-direction:column;gap:9px;padding:19px;border:1px solid var(--line);border-radius:7px;background:linear-gradient(140deg,#111b2a,#0c121d)}.category-grid a:hover{border-color:#3868a5}.category-grid small{font-size:8px;color:#7faaf0}.category-grid b{font:650 14px Manrope}.category-grid span{font-size:9px;color:#8292a8;line-height:1.6}.category-grid i{position:absolute;right:17px;top:17px;color:#8db8f8;font-style:normal}
@media(max-width:850px){.lead-grid{grid-template-columns:1fr}.topic-list{display:grid;grid-template-columns:repeat(2,1fr);gap:0 15px}.topic-list>small{grid-column:1/-1}.category-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.news-width{width:calc(100% - 40px)}.news-head{padding-top:30px}.headline{padding:37px 0 24px}.headline h1{font-size:39px;letter-spacing:-2px}.headline p{font-size:11px}.headline aside{display:none}.news-search{height:45px}.news-search button{padding:0 12px}.news-main{padding-top:38px}.section-head h2{font-size:22px}.lead-card{grid-template-columns:1fr}.lead-art{min-height:185px}.lead-copy{padding:21px}.lead-copy h3{font-size:19px}.news-cards{grid-template-columns:1fr}.news-thumb{height:130px}.topic-list{grid-template-columns:1fr}.category-grid{grid-template-columns:1fr 1fr}.category-grid a{padding:14px}.category-grid b{font-size:12px}}
</style>
</SecondaryLayout>